SET DELETED ON
SET TALK OFF
SET SAFE OFF
SET DATE TO BRITI

CREAT CURSOR REPSTK(QUALITY C(12),WASHTYPE C(10),RCOD C(4),OPQTY N(12,3),PURQTY N(12,3),WSHIQTY N(12,3),WSHRQTY N(12,3),ISSDYQTY N(12,3),ISSUPQTY N(12,3),RETSUPQTY N(12,3))
*1) White Yarn Opening
SELECT WASHTYPE,QUALITY,sum(NETWT) as NETWT,PADR('YOP1',4) as RCOD;
FROM YRNOP;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR YOP

*2) White Yarn Purchase
SELECT WASHTYPE,QUALITY,SUM(NETWT) NETWT,PADR('YPU1',4) as RCOD;
FROM YRNRECVD;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR YPU

*3) White Yarn Issue to Washing
SELECT WASHTYPE,QUALITY,SUM(QTY) NETWT,PADR('YWI1',4) as RCOD;
FROM YRNWSHISS ;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR YWI

*4) White Yarn Received From Washing
SELECT WASHTYPE,QUALITY,SUM(QTY) NETWT,PADR('YWR1',4) as RCOD;
FROM YRNWSHRCD ;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR YWR

*5) White Yarn Issue to Dyeing
SELECT WASHTYPE,QUALITY,SUM(QUANTITY) NETWT,PADR('YID1',4) as RCOD;
FROM YRNISSDY;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR YID

*6) White Yarn Issue to Supplier where Wash='N'
SELECT WASHTYPE,QUALITY,SUM(QUANTITY) NETWT,PADR('WIS1',4) as RCOD;
FROM WIISSUE;
WHERE DYEWHT='W';
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR WIS

*7) White Yarn Return From Supplier where Wash='N'
SELECT WASHTYPE,QUALITY,SUM(QUANTITY) NETWT,PADR('WIR1',4) as RCOD;
FROM WIRETURN;
WHERE DYEWHT='W';
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR WIR

*---all data in same container distinguished by rcode
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YOP;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YPU;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YWI;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YWR;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YID;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM WIS;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM WIR;  
INTO CURSOR STK1

***** distribute all data according to fields
SELECT STK1
DO WHILE .NOT. EOF()
SELECT REPSTK
APPEN BLANK
repl washtype with STK1->washtype,RCOD WITH STK1->RCOD,QUALITY WITH STK1->QUALITY
do case
	case rcod='YOP1'
		repl REPSTK->OPQTY with STK1->netwt
	case rcod='YPU1'
		repl REPSTK->PURQTY with STK1->netwt
	case rcod='YWI1'
		repl  REPSTK->WSHIQTY with STK1->netwt
	case rcod='YWR1'
		repl REPSTK->WSHRQTY with STK1->netwt
	case rcod='YID1'
		repl REPSTK->ISSDYQTY with STK1->netwt
	case rcod='WIS1'
		repl REPSTK->ISSUPQTY with STK1->netwt
	case rcod='WIR1'
		repl REPSTK->RETSUPQTY with STK1->netwt
  endcase
   SELECT STK1
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
SELECT WASHTYPE,QUALITY,SUM(OPQTY) OPQTY, SUM(PURQTY) PURQTY, SUM(WSHIQTY) WSHIQTY, SUM(WSHRQTY) WSHRQTY, SUM(ISSDYQTY) ISSDYQTY, SUM(ISSUPQTY) ISSUPQTY, SUM(RETSUPQTY) RETSUPQTY;
FROM REPSTK;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCKY2

SELECT WASHTYPE,QUALITY,OPQTY+PURQTY-WSHIQTY+WSHRQTY-ISSDYQTY-ISSUPQTY+RETSUPQTY AS BALANCE;
FROM REPSTOCKY2;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCKY1

SELECT i.WASHTYPE,i.QUALITY,i.BALANCE,j.YTYPE;
FROM REPSTOCKY1 i,Wiqlty j;
WHERE i.quality=j.quality;
INTO CURSOR REPSTOCKYA

SELECT WASHTYPE,SUM(BALANCE) AS BALANCE,YTYPE;
FROM REPSTOCKYA;
GROUP BY WASHTYPE,YTYPE;
INTO CURSOR REPSTOCKWY

************Total TTC Undyed Silk/Yarn/Cotton*******
SELECT Washtype,Ytype,Balance;
FROM REPSTOCKWY;
Where Washtype="TTC" .and. Ytype="SILK";
Into Cursor RTTCs

Public m.USilk,m.UYarn,m.Cotton

SELECT RTTCs
m.USilk=RTTCs->Balance
****************************************
SELECT Washtype,Ytype,Balance;
FROM REPSTOCKWY;
Where Washtype="TTC" .and. Ytype="YARN";
Into Cursor RTTCy

SELECT RTTCy
m.UYarn=RTTCy->Balance
****************************************
SELECT Washtype,Ytype,Balance;
FROM REPSTOCKWY;
Where Washtype="TTC" .and. Ytype="COTTON";
Into Cursor RTTCc

SELECT RTTCc
m.Cotton=RTTCc->Balance
****************************************


