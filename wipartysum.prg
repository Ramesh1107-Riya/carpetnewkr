*Party Summary Report
***All Party Summary Report
SET DELETED ON
SET TALK OFF
SET SAFE OFF

PROCEDURE ALLPARTY
CREATE CURSOR PARTYSUM (QUALITY C(8),RETNQTY N(11,3),ISSQTY N(11,3),PARTY C(15))

SELECT QUALITY,SUM(QUANTITY) RETNQTY,PARTY;
FROM WIRETURN;
WHERE date=>m.startdt .and. date=<m.enddt;
GROUP BY PARTY,QUALITY;
ORDER BY PARTY,QUALITY;
INTO CURSOR REV3

SELECT QUALITY,SUM(QUANTITY) ISSQTY,PARTY;
FROM WIISSUE;
WHERE date=>m.startdt .and. date=<m.enddt;
GROUP BY PARTY,QUALITY;
ORDER BY PARTY,QUALITY;
INTO CURSOR ISS3
RETU
***End All Party

***Single Party Summary Report
PROCEDURE ONEPARTY
CREATE CURSOR PARTYSUM (QUALITY C(8),RETNQTY N(11,3),ISSQTY N(11,3),PARTY C(15))

SELECT QUALITY,SUM(QUANTITY) RETNQTY,PARTY;
FROM WIRETURN;
WHERE Party=m.Party .and. date=>m.startdt .and. date=<m.enddt;
GROUP BY PARTY,QUALITY;
ORDER BY PARTY,QUALITY;
INTO CURSOR REV3

SELECT QUALITY,SUM(QUANTITY) ISSQTY,PARTY;
FROM WIISSUE;
WHERE Party=m.Party .and. date=>m.startdt .and. date=<m.enddt;
GROUP BY PARTY,QUALITY;
ORDER BY PARTY,QUALITY;
INTO CURSOR ISS3
RETU
**End-Single Party 

***Report Making to both single and all party
PROCEDURE REPMAKE
SELECT PARTYSUM
APPEND FROM DBF('ISS3')
APPEND FROM DBF('REV3')

SELECT QUALITY,ISSQTY,RETNQTY,(ISSQTY-RETNQTY) AS BALANCE,PARTY;
FROM PARTYSUM;
ORDER BY PARTY,QUALITY DESC;
INTO CURSOR PARTYSUM1

If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wipartysum.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wipartysum.frx to printer prompt noconsole
Endcase
Endif
RETURN


