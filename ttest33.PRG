Select a as buyserial,recno() as slno;
From  epcslno;
Into table epcslno1

Select e.slno,Bcode,po_no,notes,spcl_inst,WashType,ol_no,Cstatus,Ctrl_No as serial,Yrncaldt as Deli_dt,buyserial,Design,Quality,Colour+padr('',7) as colour,Szcode,sqmt,PADR('',12) as NewEpc;
From cabuyord b;
Right Join epcslno1 e;
ON b.ctrl_no=e.buyserial; && a is imported serial 
Union all;
Select e.slno,Bcode,po_no,substr(notes,1,20) as notes,spcl_inst,WashType,ol_no,Cstatus,Ctrl_No as serial,Yrncaldt as Deli_dt,buyserial,Design,Quality,Colour,Szcode,sqmt,PADR('',12) as NewEpc;
From stkcarpet b;
Right Join epcslno1 e;
ON b.ctrl_no=e.buyserial; && a is imported serial 
Into Cursor EpcDat1a

Select slno,b.Bcode,po_no,notes,spcl_inst,WashType,name,ol_no,Cstatus,buyserial,Deli_dt,Design,quality,colour,Szcode,sqmt,NewEpc;
From EpcDat1a b;
Join Cabuyer e;
ON b.Bcode=e.bcode; && a is imported serial 
order by slno;
Into Cursor EpcDat1

Select b.slno,Bcode,po_no,notes,spcl_inst,WashType,name,ol_no,Cstatus,b.buyserial,Deli_dt,Design,quality,colour,Szcode,sqmt,NewEpc;
From epcslno1 b;
Left Join EpcDat1 e;
ON b.buyserial=e.buyserial; && a is imported serial 
order by b.slno;
Into Cursor EpcDat


