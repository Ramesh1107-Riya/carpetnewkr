Select i.*,j.invno;
From EpcDatNew i;
Left Join Packtran j;
ON i.ol_no=j.ol_no;
Into Cursor EpcDatNew1

Select i.*,j.invdt,j.ship_inst,Alltrim(j.Name) as Buyer,Alltrim(j.Compname2) as Company;
From EpcDatNew1 i;
Left Join expackingnp j;
ON i.invno=j.invno;
Into Cursor EpcDatNew2

Select slno,Bcode,po_no,notes,spcl_inst,WashType,name,ol_no,Cstatus,buyserial,Deli_dt,Design,quality,colour,Szcode,sqmt,NewEpc,iif(isnull(invdt),{},invdt)as invdt,iif(Isnull(ship_inst),'   ',ship_inst) as ship_inst,;
	iif(ISnull(Buyer),'                        ',Buyer) as Buyer,iif(Isnull(Company),'                 ',Company) as Company;
From EpcDatNew2

