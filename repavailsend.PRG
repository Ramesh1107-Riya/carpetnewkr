*repavailsend.prg
set procedure to catool
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

DO csTrimInfo11      && Trim Information for Check Purpose !
Open Database Carpet
  
SELECT Padr(' ',10) as Id,i.Carpetno,i.supplier,i.Carpetno as ol_no,j.QltyGroup as PO_No,i.bcode,i.Design,i.Quality,j.QltyGroup,i.Colour,i.Rbillno,i.SRetQty,i.SRetDt,i.Rackno,Padr(' ',15) as Remark,i.Label,i.pno;
FROM  Yrnissrecsup i,wiqlty j;
Where i.Quality=j.Quality .and. i.SRetDt=>m.Text1 .and. i.SRetDt<=m.Text2 .and. i.Label=.F. .and. i.SRetQty>0  .and. (i.Colour<>'NATURAL' .OR. i.Colour<>'142R' .OR. i.Colour<>'BLEACHED');
ORDER BY i.SRetDt;
INTO CURSOR ctemprepa

Select * ;
From ctemprepa;
WHERE ccsMatch22(Supplier,Bcode,Quality,DESIGN,PO_NO,OL_NO);
Into Cursor cTemprep

IF RECCOUNT("cTemprep") <= 0
  ?? CHR(7)
  WAIT WINDOW "No Matching Records found ..." TIMEOUT 1
  RETURN 0
ENDIF

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make another Cursor for Read-Write purpose.
*
USE (DBF([cTemprep])) ALIAS cTemp2 AGAIN IN 0 SHARED
USE IN SELECT([cTemp])

SELECT cTemp2
INDEX ON carpetno  TAG carpetno
SET ORDER TO Carpetno

*
* Now We have the Cursor to Manipulate anything. So, now return the command to the calling program.

PRIVATE  m.csVar1,m.csVar2,m.csVar9
m.csVar3=.T.
m.csVar4=.F.

* Now Display ALL the Found Records and allow the user to Mark them for Available Store
DEFINE WINDOW csoSrchWn_ FROM 00,00 TO 55,120 IN SCREEN DOUBLE CLOSE ;
  FLOAT GROW ZOOM TITLE "Send to Available Store , [Y] to Select - and Press [F10] Entry, [Esc] to Exit " COLOR SCHEME 10 && you can get better this color tested 11/5/10
?? CHR(7)
WAIT WINDOW ALLTRIM(STR(RECCOUNT("cTemp2"))) + " Matching Pieces Found !" NOWAIT

SELECT cTemp2
*REPLACE ALL LABEL WITH .F.
REPLACE ALL LABEL WITH .T. && Ramesh Modified 5/12/2020
GO TOP
m.csVar9  = ON("KEY", "F10")
ON KEY LABEL F10     KEYBOARD CHR(23)

BROWSE FIELDS LABEL:H="Send?":P="Y":7,OL_NO:H="Carpet No.":16:R, BCODE:H="BuyerCode":10:R,DESIGN:H="Design":18:R,COLOUR:H="Color":11:R, Quality:H="Quality":12:R,;
	sRetQty:H="Return Qty":9:R,SRetDt:H="Return Dt":9:R,Rbillno:H='RBillNo':7:R REST FREEZE LABEL NOAPPEND NODELETE NOMENU;
  TITLE "Estimated Carpets Searched by Criteria... [Y] to Select - and Press [F10] For Entry,[Esc] to Exit"  ;
  WINDOW csoSrchWn_  COLOR SCHEME 10 && test 11/5/10 this is best color in color scheme
 
m.csVar1  = LASTKEY()
ON KEY LABEL F10   &csVar9

IF m.csVar1 = 23     && F10 Pressed: ask other Inputs to Record !
  COUNT TO m.csVar1  FOR LABEL
  IF m.csVar1 <= 0
    ?? CHR(7)
    WAIT WINDOW "No Pieces Marked for Available Store !!" TIMEOUT 2
    USE IN cTemp2
    _screen.activeform.release()
    RETURN
ENDIF
* Now ask the necessary Infos. for the Marked Pieces and Save them in cTemp2.dbf
m.csVar2  = ALLTRIM(STR(m.csVar1)) + " Pieces Marked for Undyed Store"
RELEASE WINDOW csoSrchWn_
Endif

SELECT Id,Carpetno,supplier,bcode,Design,Quality,QltyGroup,Colour,Rbillno,SRetQty,SRetDt,Rackno,Remark,Label,pno;
FROM cTemp2;
Order by carpetno;
Where LABEL=.T.;
Into Cursor ctemp2a


SELECT Id,Carpetno,supplier,bcode,Design,Quality,QltyGroup,Colour,Rbillno,SRetQty,SRetDt,Rackno,Remark,Label,pno;
FROM cTemp2;
Order by carpetno;
Where LABEL=.T.;
Into Cursor ctemp2a

Update Yrnissrecsup;
Set Label =.T.;
WHERE carpetno IN(SELECT carpetno FROM cTemp2a Where LABEL=.T.)
					
Select count(carpetno) as carpcnt;
From  cTemp2a;
Into Cursor cTemp3

USE (DBF([ctemp2a])) ALIAS cTemp3a AGAIN IN 0 SHARED
USE IN SELECT([cTemp2a])

 
***Insert Automatic unique ID******
*do AutoId && program to generate first id
Local m.StartId,m.EndId,m.NewId1,m.NewId2,m.NumRec,m.Autno,m.Automax
Store 0 to m.Autno,m.Automax
Select cTemp3
m.NumRec=cTemp3->carpcnt

Select max(val(id)) as maxid;
From Available;
Into Cursor cid
Select cid
m.Autno=cid->maxid
if m.Autno>0
	m.Automax=m.Autno
Else
	m.Automax=100000
endif

m.StartId=m.Automax+1
m.EndId=m.StartId+m.NumRec-1
For m.NewId1=m.StartId TO m.EndId STEP 1
	m.NewId2=PADL(Alltrim(STR(NewId1,6,0)),6,'0')
	Select cTemp3a
	Repl id with m.NewId2, Remark with 'Sup-Return'
	IF .NOT. EOF()
	   SKIP
	ENDIF
Endfor 

*******Inserting Data into Available Stock*****************
Select cTemp3a
SCAN
DO WHILE .NOT. EOF()
Select Available
 Appen Blank
 repl Id with cTemp3a.Id, Carpetno with cTemp3a.carpetno,Supplier with cTemp3a.Supplier,quality with cTemp3a.quality,bcode with cTemp3a.bcode,design with cTemp3a.design,;
	colour with cTemp3a.colour,Rbillno with cTemp3a.Rbillno,SRetQty with cTemp3a.SRetQty,SRetDt with cTemp3a.SRetDt,Rackno with cTemp3a.Rackno,Remark with cTemp3a.Remark,;
	pno with cTemp3a.pno,qltygroup with cTemp3a.qltygroup
 Select cTemp3a
 IF .NOT. EOF()
   SKIP
 ENDIF
ENDDO
ENDSCAN
	?? CHR(7)
      WAIT WINDOW "ALL Selected Dyed Return Yarn Sent to Available Store!!" TIMEOUT 1 
USE IN cTemp3a
UNLOCK ALL
RELEASE WINDOW csoSrchWn_
RELEASE WINDOW _TempWin
RETURN
* EoP()

