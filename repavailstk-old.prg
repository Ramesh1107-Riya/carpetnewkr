*repavailstk.prg
set procedure to catool
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

DO csTrimInfo11      && Trim Information for Check Purpose !
Open Database Carpet

*1) Available Issue is grouped and Added by Id to get total Issue Qty by ID
SELECT Id,Quality,QltyGroup,Colour,sum(netwt) as Netwt;
FROM Yrndysttrn;
Group by Id;
Into Cursor cIssue

*2) IssAval is Stock in Available received from Supplier-Available Issue
SELECT i.Id,i.Carpetno,i.bcode,i.Design,i.Quality,i.QltyGroup,i.Colour,i.SRetQty-iif(j.Netwt>0,j.Netwt,0.0) as Qty,i.Rackno,i.Remark,Pno;
FROM Available i;
Left Join cIssue j;
On i.Id=j.Id;
Order by i.Id;
Into Cursor IssAval

*3) IssOpn is Stock in Available Opening-Available Issue
SELECT i.Id,i.Quality,i.QltyGroup,i.Colour,i.NetWt-iif(j.Netwt>0,j.Netwt,0.0) as Qty,i.Rackno,i.Remark;
FROM Yrndystopn i;
Left Join cIssue j;
On i.Id=j.Id;
Where (i.NetWt-j.Netwt>0.010);
Order by i.Id;
Into Cursor IssOpn
select IssOpn
brow

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose.
* make IssAval Read-Write to appen IssOpn, We have 2)+3)together
USE (DBF([IssAval])) ALIAS IssAvalStk AGAIN IN 0 SHARED
USE IN SELECT([IssAval])

SELECT IssAvalStk
APPEND FROM DBF('IssOpn')

Select Id,Carpetno as OL_NO,bcode,Design,Quality,QltyGroup as Supplier,Colour as PO_NO,Qty,Rackno,Remark,Pno;
From IssAvalStk;
Into Cursor IssAvalStk1

Select * ;
From IssAvalStk1;
WHERE ccsMatch22(Supplier,Bcode,Quality,DESIGN,PO_NO,OL_NO);
Into Cursor cTemprep

IF RECCOUNT("cTemprep") <= 0
  ?? CHR(7)
  WAIT WINDOW "No Matching Records found ..." TIMEOUT 1
  RETURN 0
ENDIF

SELECT Id,OL_No as Carpetno,bcode,Design,Quality,Supplier as QltyGroup,PO_NO as Colour,Qty,Rackno,Remark,Pno;
From cTemprep;
Into Cursor cTemprep1

USE IN SELECT([cTemprep]) && close this cursor for re-use
USE IN SELECT([IssAvalStk])

