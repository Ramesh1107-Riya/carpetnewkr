*******White Yarn Stock Summary Report
**WASHTYPE C(10) OF CAWSHTYP.DBF stores company name PCI/TTC/JW

Local m.date
m.date=Date()

CREAT CURSOR REPSTK(WASHTYPE C(10),QUALITY C(10),OPQTY N(12,3),PURQTY N(12,3),ISSDYQTY N(12,3),ISSSUPQTY N(12,3),RCDSUPQTY N(12,3),RCOD C(4))
*1) White Yarn Opening
SELECT WASHTYPE,QUALITY,SUM(NETWT) NETWT,PADR('YOP1',4) as RCOD;
FROM YRNOP;
GROUP BY QUALITY,WASHTYPE;
ORDER BY QUALITY,WASHTYPE;
INTO CURSOR YOP

*2) White Yarn Purchase
SELECT WASHTYPE,QUALITY,SUM(NETWT) NETWT,PADR('YPU1',4) as RCOD;
FROM YRNRECVD;
WHERE recdt=<m.date;
GROUP BY QUALITY,WASHTYPE;
ORDER BY QUALITY,WASHTYPE;
INTO CURSOR YPU

*3) White Yarn Issue to Dyeing
SELECT WASHTYPE,QUALITY,SUM(QUANTITY) NETWT,PADR('YID1',4) as RCOD;
FROM YRNISSDY;
WHERE date=<m.date;
GROUP BY QUALITY,WASHTYPE;
ORDER BY QUALITY,WASHTYPE;
INTO CURSOR YID

*4) White Yarn Issue to Supplier where Wash='N'
SELECT i.WASHTYPE,i.QUALITY,SUM(i.QUANTITY) NETWT,PADR('WIS1',4) as RCOD;
FROM WIISSUE i,YRNOP j;
WHERE i.QUALITY=j.QUALITY;
GROUP BY i.QUALITY,i.WASHTYPE;
ORDER BY i.QUALITY,i.WASHTYPE;
INTO CURSOR WIS

*5) White Yarn Return From Supplier where Wash='N'
SELECT i.WASHTYPE,i.QUALITY,SUM(i.QUANTITY) NETWT,PADR('WIR1',4) as RCOD;
FROM WIRETURN i, YRNOP j;
WHERE i.WASHTYPE=j.WASHTYPE;
GROUP BY i.QUALITY,i.WASHTYPE;
ORDER BY i.QUALITY,i.WASHTYPE;
INTO CURSOR WIR

***All data in same container distinguished by rcode
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YOP;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YPU;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM YID;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM WIS;
UNION ALL;
SELECT WASHTYPE,QUALITY,NETWT,RCOD;
FROM WIR;
INTO CURSOR STK1

SELECT STK1
BROW

***** distribute all data according to fields
SELECT STK1
DO WHILE .NOT. EOF()
SELECT REPSTK
APPEN BLANK
repl QUALITY with STK1->QUALITY,WASHTYPE with STK1->WASHTYPE,rcod with STK1->rcod
do case
	case rcod='YOP1'
		repl REPSTK->OPQTY with stk1->netwt
	case rcod='YPU1'
		repl REPSTK->PURQTY with stk1->netwt
	case rcod='YID1'
		repl REPSTK->ISSDYQTY with stk1->netwt
	case rcod='WIS1'
		repl REPSTK->ISSSUPQTY with stk1->netwt
		case rcod='WIR1'
	repl REPSTK->RCDSUPQTY with stk1->netwt		
  endcase
   SELECT stk1
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
SELECT WASHTYPE,QUALITY,SUM(OPQTY) OPQTY, SUM(PURQTY) PURQTY, SUM(ISSDYQTY) ISSDYQTY, SUM(ISSSUPQTY) ISSSUPQTY, SUM(RCDSUPQTY) RCDSUPQTY;		
FROM REPSTK;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCKY1


SELECT WASHTYPE,QUALITY,OPQTY,PURQTY,ISSDYQTY,OPQTY+PURQTY-ISSDYQTY-ISSSUPQTY+RCDSUPQTY AS BALANCE;
FROM REPSTOCKY1;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCKY2

SELECT REPSTOCKY2
BROW

SELECT WASHTYPE,QUALITY,SUM(BALANCE) AS WYSTKTT;
FROM REPSTOCKY2;
Where Washtype='TTC';
INTO CURSOR REP3

Select Rep3
brow

SELECT WASHTYPE,QUALITY,SUM(BALANCE) AS WYSTKTJ;
FROM REPSTOCKY2;
WHERE Washtype='JW' .or. Washtype='PCI' .or. Washtype='MTRF';
INTO CURSOR REP4

Select Rep4
brow


