close all
SET Date to american
Select a as buyserial,recno() as slno;
From  epcslno;
Into table epcslno1

Select e.slno,Bcode,ol_no,Cstatus,Ctrl_No as serial,MDY(Yrncaldt) as Deli_dt,buyserial,PADR('',12) as NewEpc;
From cabuyord b;
Right Join epcslno1 e;
ON b.ctrl_no=e.buyserial; && a is imported serial 
Union all;
Select e.slno,Bcode,ol_no,Cstatus,Ctrl_No as serial,MDY(Yrncaldt) as Deli_dt,buyserial,PADR('',12) as NewEpc;
From stkcarpet b;
Right Join epcslno1 e;
ON b.ctrl_no=e.buyserial; && a is imported serial 
Into Cursor EpcDat1a

Select slno,b.Bcode,alltrim(name) as name,ol_no,Cstatus,buyserial,Deli_dt,NewEpc;
From EpcDat1a b;
Join Cabuyer e;
ON b.Bcode=e.bcode; && a is imported serial 
order by slno;
Into Cursor EpcDat

