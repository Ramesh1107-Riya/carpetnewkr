*******Procedure to print Particular Customer form wicolour, For Particular Colour
**Repstock same in both
Procedure Querygen
SET DELETED ON
SET TALK OFF
SET SAFE OFF

CREATE CURSOR REPSTOCK (QUALITY C(10),COLOUR C(10),OPORDQTY N(10,3),;
RECQTY N(11,3),ORDQTY N(11,3),RECQTYM N(11,3),ORDQTYM N(11,3),RCOD C(3))
*******Calculate total till date
IF !EMPTY(m.customer) && Select for particular customer
	SELECT QUALITY,COLOUR,(OPORDQTY) AS QUANTITY,PADR('WOP',3) as RCOD;
	FROM WISTOCK;
	WHERE CUSTOMER=m.customer;
	INTO CURSOR WIOP
ELSE
	SELECT QUALITY,COLOUR,(OPORDQTY) AS QUANTITY,PADR('WOP',3) as RCOD;
	FROM WISTOCK;
	INTO CURSOR WIOP
ENDIF

*******Calculate total till date DYINGLOAD=QUANTITY not true 22/02/2015
SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REV',3) as RCOD;
FROM WIRECV SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ORD',3) as RCOD;
FROM WITRNORD SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIORD

***CALCULATE MONTH TOTAL
**quantity used not dyeingload, later change variable dyeingload
SET ANSI ON
SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REM',3) as RCOD;
FROM WIRECV SHARE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECVM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ORM',3) as RCOD;
FROM WITRNORD SHARE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIORDM

*---all data in same container distinguished by rcode
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WIOP;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RECV;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RECVM;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WIORD;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WIORDM;
INTO CURSOR wistk

***** distribute all data according to fields
SELECT wistk 
DO WHILE .NOT. EOF()
SELECT REPSTOCK
APPEN BLANK
repl quality with wistk->quality,colour with wistk->colour,rcod with wistk->rcod

do case
	case rcod='WOP'
		repl repstock->OPORDQTY with wistk->Quantity
	case rcod='REV'
		repl repstock->RECQTY with wistk->Quantity
	case rcod='ORD'
		repl repstock->ORDQTY with wistk->Quantity
	case rcod='REM'
		repl repstock->RECQTYM with wistk->Quantity
	case rcod='ORM'
		repl repstock->ORDQTYM with wistk->Quantity
	endcase
   SELECT wistk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

RETURN
**END OF Querygen

****One Customer all Quality (Detail Rep,Summary), One Customer One Quality (Detail Rep)

Procedure Detailrep
Do Case   
  	
  Case !Empty(m.quality) .and. !Empty(m.colour)
	SELECT QUALITY,COLOUR,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING QUALITY=m.quality .and. COLOUR=m.colour &CONDITION;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3	

  *EXCLUE BALANCE=0 OR DO NOT INCLUDE BALANCE=0 UPON CONDITION
  Case !Empty(m.quality) 
	SELECT QUALITY,COLOUR,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING QUALITY=m.quality &CONDITION;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3

	**EXCLUDE BALNCE=0 IN REPORT
  Case Empty(m.quality)  
	SELECT QUALITY,COLOUR,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING (ORDQTY+ORDQTYM)!=(OPORDQTY+RECQTY+RECQTYM);
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
Endcase  
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wiorder.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wiorder.frx to printer prompt noconsole
Endcase
Endif
RETURN

*All customer & All Quality
Procedure StockSumary
Do case
  Case m.chk1=1 .and. empty(m.quality)
	SELECT QUALITY,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	GROUP BY QUALITY;
	ORDER BY QUALITY;
	INTO CURSOR REP4

  Case m.chk1=1 .and. !empty(m.quality)
	SELECT QUALITY,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	GROUP BY QUALITY;
	HAVING QUALITY=m.quality;
	ORDER BY QUALITY;
	INTO CURSOR REP4
Endcase
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wiordersm.frx PREVIEW WINDOW wReport  
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wiordersm.frx to printer prompt noconsole
Endcase
Endif
RETURN
