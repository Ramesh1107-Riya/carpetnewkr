*Carpet Progress Report made from Order Not Distributed Report- for this required fileds are little more
SET DELETED ON
Set talk off
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

SET PROCEDURE TO CATOOL
DO csTrimInfo      && Trim Information for Check Purpose !
Open Database Carpet

SELECT PO_NO, PO_DT, BCODE, CTRL_NO, OL_NO, QUALITY, DESIGN, SZCODE, COLOUR, FIELDCODE,;
 	WASHTYPE, SPCL_INST, COMMENT, b.CSTATUS, ORDER_TYPE, CTYPE, SQMT, DELIRY_DT,QTY,c.GSTATUS;
FROM  Carpet!Cabuyord b, CSTATUS c;
WHERE c.status=b.cstatus .AND. PO_DT>=m.Startdt .and. PO_DT<=m.Enddt;
INTO CURSOR BUYSTATUS

SELECT  PO_NO,PO_DT, BCODE, CTRL_NO, OL_NO, QUALITY, DESIGN, SZCODE, COLOUR, FIELDCODE,;
 	WASHTYPE, SPCL_INST, COMMENT,CSTATUS, ORDER_TYPE, CTYPE, SUM(SQMT) AS SQMT, DELIRY_DT,SUM(QTY) AS QTY,GSTATUS;
FROM  BUYSTATUS;
WHERE ccsMatch6a(BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR);
ORDER BY PO_NO,Design,szcode,Quality,Deliry_Dt;
Group By PO_NO,Design,szcode,Quality,GSTATUS;
INTO CURSOR CAPROGRES

SELECT  DESIGN,SZCODE,GSTATUS,PO_NO,PO_DT,BCODE,COLOUR,DELIRY_DT,QUALITY,SQMT,SQMT*0 AS PNsqmt,SQMT*0 AS RDsqmt,SQMT*0 AS PKsqmt,SQMT*0 AS EXsqmt,;
			QTY*0 AS PNqty,QTY*0 AS RDqty,QTY*0 AS PKqty,QTY*0 AS EXqty;
FROM CAPROGRES;
ORDER BY BCODE;
INTO CURSOR CAPROGRESDITN1

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose. Cursor CAPROGRESDITN (R/W)
*
set safety off
SELECT CAPROGRESDITN1
= AFIELDS(csccTmpArr)
CREATE CURSOR CAPROGRESDITN FROM ARRAY csccTmpArr
SELECT CAPROGRESDITN1
GO TOP
SCAN WHILE (.NOT. EOF())
    SCATTER TO csccTmpRec
    INSERT INTO CAPROGRESDITN FROM ARRAY csccTmpRec
	SELECT CAPROGRESDITN1
ENDSCAN
RELEASE csccTmpArr, csccTmpRec
USE IN CAPROGRESDITN1

***** distribute all data according to fields
SELECT CAPROGRES
DO WHILE .NOT. EOF()
SELECT CAPROGRESDITN
Locate for Design=Caprogres->Design .and. Szcode=Caprogres->Szcode .and. Po_No=Caprogres->Po_No .and. Colour=Caprogres->Colour
do case
	case CAPROGRES->GSTATUS='PRODUCTN'
		repl CAPROGRESDITN->PNsqmt with CAPROGRES->sqmt,CAPROGRESDITN->PNqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='READY'
		repl CAPROGRESDITN->RDsqmt with CAPROGRES->sqmt,CAPROGRESDITN->RDqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='PACKED'
		repl CAPROGRESDITN->PKsqmt with CAPROGRES->sqmt,CAPROGRESDITN->PKqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='EXPORTED'
		repl CAPROGRESDITN->EXsqmt with CAPROGRES->sqmt,CAPROGRESDITN->EXqty with CAPROGRES->Qty
  endcase
   SELECT CAPROGRES
 	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO
set safety on

SELECT DESIGN,SZCODE,GSTATUS,PO_NO,PO_DT,BCODE,COLOUR,DELIRY_DT,QUALITY,sum(PNsqmt) As pnsqmt,sum(RDsqmt) As rdsqmt,sum(PKsqmt) As pksqmt,;
	 sum(EXsqmt) As exsqmt, sum(PNqty) As pnqty, sum(RDqty) As rdqty, sum(PKqty) As pkqty,sum(EXqty) As exqty;
From CAPROGRESDITN;
ORDER BY BCODE;
Group By BCODE;
Into  Cursor CaProgRep

Select CaProgRep
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V" .and. m.Option="A" 
		Report form caprogressumbuyer.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P" .and. m.Option="B" 
		Report form caprogressumbuyer.frx to printer prompt noconsole
	Case  m.PrnStat="V" .and. m.Option="C"  
		EXPORT TO &exclfile TYPE XL5 FIELDS PO_NO,DESIGN,COLOUR,QUALITY,SZCODE,SQMT,DELIRY_DT;
 	Messagebox("Search Non Distributed Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
Endcase
Endif
USE IN CAPROGRESDITN
UNLOCK ALL
Return
