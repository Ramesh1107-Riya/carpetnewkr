SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _46c0ui84o OF _MSYSMENU PROMPT "\<System Setup" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _46c0ui84p OF _MSYSMENU PROMPT "\<Transaction" COLOR SCHEME 3 ;
	KEY ALT+T, ""
DEFINE PAD _46c0ui84q OF _MSYSMENU PROMPT "\<Reports" COLOR SCHEME 3 ;
	KEY ALT+R, ""
DEFINE PAD _46c0ui84r OF _MSYSMENU PROMPT "S\<ystem Utilities" COLOR SCHEME 3 ;
	KEY ALT+Y, ""
DEFINE PAD _46c0ui84s OF _MSYSMENU PROMPT "\<Exit" COLOR SCHEME 3 ;
	KEY ALT+E, ""
ON PAD _46c0ui84o OF _MSYSMENU ACTIVATE POPUP systemsetu
ON PAD _46c0ui84p OF _MSYSMENU ACTIVATE POPUP transactio
ON PAD _46c0ui84q OF _MSYSMENU ACTIVATE POPUP reports
ON PAD _46c0ui84r OF _MSYSMENU ACTIVATE POPUP systemutil
ON SELECTION PAD _46c0ui84s OF _MSYSMENU DO ENDPRG

DEFINE POPUP systemsetu MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF systemsetu PROMPT "Opening Entry"
ON SELECTION BAR 1 OF systemsetu do form wistock

DEFINE POPUP transactio MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF transactio PROMPT "Dyeing Order Yarn/Wool"
DEFINE BAR 2 OF transactio PROMPT "Receive Yarn/Wool"
DEFINE BAR 3 OF transactio PROMPT "Issue  Yarn/Wool"
ON SELECTION BAR 1 OF transactio do form witrnord
ON SELECTION BAR 2 OF transactio do form wirecv
ON SELECTION BAR 3 OF transactio do  form wiissue

DEFINE POPUP reports MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF reports PROMPT "Dyeing Order"
DEFINE BAR 2 OF reports PROMPT "Stock Report"
DEFINE BAR 3 OF reports PROMPT "Reorder"
DEFINE BAR 4 OF reports PROMPT "Item (Colour) Ledger"
DEFINE BAR 5 OF reports PROMPT "Party Ledger"
DEFINE BAR 6 OF reports PROMPT "Dyeing Loss"
DEFINE BAR 7 OF reports PROMPT "Party & Qualitywise Crosstable"
ON SELECTION BAR 1 OF reports do form wiorderep
ON SELECTION BAR 2 OF reports do form wistockrep
ON BAR 3 OF reports ACTIVATE POPUP reorder
ON SELECTION BAR 4 OF reports do form wiitemledg
ON SELECTION BAR 5 OF reports do form wipartyledg
ON SELECTION BAR 6 OF reports do form widyeinglo
ON SELECTION BAR 7 OF reports do form wicrosqlty

DEFINE POPUP reorder MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF reorder PROMPT "Reorder List"
DEFINE BAR 2 OF reorder PROMPT "Reorder (Quality,Colour) Report"
DEFINE BAR 3 OF reorder PROMPT "Yarn Re-Order (NotDistri) Report"
ON SELECTION BAR 1 OF reorder do form wireorder
ON SELECTION BAR 2 OF reorder do form wiquality
ON SELECTION BAR 3 OF reorder do form wireordndist

DEFINE POPUP systemutil MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF systemutil PROMPT "Backup"
DEFINE BAR 2 OF systemutil PROMPT "Year Closing"
DEFINE BAR 3 OF systemutil PROMPT "Refresh"
