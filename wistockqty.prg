*******Procedure to print Particular Customer form wicolour, For Particular Colour
**Repstock same in both
SET DELETED ON
SET TALK OFF
SET SAFE OFF

Procedure Querygen
CREATE CURSOR REPSTOCK (QUALITY C(10),COLOUR C(10),OPENBAL N(10,3),PARTY C(15),;
						RECQTY N(11,3),RETNQTY N(11,3),ISSQTY N(11,3),RECQTYM N(11,3),RETNQTYM N(11,3),ISSQTYM N(11,3),RCOD C(3))
*******Calculate total till date, m.customer=m.party
SELECT QUALITY,COLOUR,(OPENBAL) AS QUANTITY,PADR('WOP',3) as RCOD,SPACE(20) AS PARTY;
FROM WISTOCK;
INTO CURSOR WIOP

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REV',3) as RCOD,PARTY;
FROM WIRECV;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('RTN',3) as RCOD,PARTY;
FROM WIRETURN;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RETN

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISS',3) as RCOD,PARTY;
FROM WIISSUE;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ISSUE

***CALCULATE MONTH TOTAL
SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REM',3) as RCOD,PARTY;
FROM WIRECV;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECVM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('RTM',3) as RCOD,PARTY;
FROM WIRETURN;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RETNM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISM',3) as RCOD,PARTY;
FROM WIISSUE;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ISSUEM

*---all data in same container distinguished by rcode
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM WIOP;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM RECV;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM RETN;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM ISSUE;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM RECVM;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM RETNM;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD,PARTY;
FROM ISSUEM;
INTO CURSOR wstk

***** distribute all data according to fields
SELECT wstk 
DO WHILE .NOT. EOF()
SELECT REPSTOCK
APPEN BLANK
repl quality with wstk->quality,colour with wstk->colour,rcod with wstk->rcod,party with wstk->party

do case
	case rcod='WOP'
		repl repstock->OPENBAL with wstk->Quantity
	case rcod='REV'
		repl repstock->RECQTY with wstk->Quantity
	case rcod='RTN'
		repl repstock->RETNQTY with wstk->Quantity
	case rcod='ISS'
		repl repstock->ISSQTY with wstk->Quantity
	case rcod='REM'
		repl repstock->RECQTYM with wstk->Quantity
	case rcod='RTM'
		repl repstock->RETNQTYM with wstk->Quantity
	case rcod='ISM'
		repl repstock->ISSQTYM with wstk->Quantity
  endcase
   SELECT wstk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO
RETURN
****End of Query Gen

****One Customer all Quality (Detail Rep,Summary), One Customer One Quality (Detail Rep), -ve,+ve all stock report
Procedure Detailrep
Do Case
  Case !Empty(m.quality) .and. !empty(m.colour)
	SELECT QUALITY,COLOUR,OPENBAL,RECQTY,RETNQTY,ISSQTY,RECQTYM,RETNQTYM,ISSQTYM;			 
	FROM REPSTOCK;
	WHERE Quality=m.Quality .and. colour=m.colour;
	ORDER BY QUALITY,COLOUR;
	GROUP BY QUALITY,COLOUR;
	INTO CURSOR REP3
	
	Case !Empty(m.quality) .and. empty(m.colour)
	SELECT QUALITY,COLOUR,OPENBAL,RECQTY,RETNQTY,ISSQTY,RECQTYM,RETNQTYM,ISSQTYM;			 
	FROM REPSTOCK;
	WHERE Quality=m.Quality;
	ORDER BY QUALITY,COLOUR;
	GROUP BY QUALITY,COLOUR;
	INTO CURSOR REP3
	
  Case Empty(m.quality) .and. !empty(m.colour)
	SELECT QUALITY,COLOUR,OPENBAL,RECQTY,RETNQTY,ISSQTY,RECQTYM,RETNQTYM,ISSQTYM;	
	FROM REPSTOCK; 
	WHERE COLOUR=m.COLOUR;
	ORDER BY QUALITY,COLOUR;
	GROUP BY QUALITY,COLOUR;
	INTO CURSOR REP3
	
  Case Empty(m.quality) .and. empty(m.colour)
	SELECT QUALITY,COLOUR,OPENBAL,RECQTY,RETNQTY,ISSQTY,RECQTYM,RETNQTYM,ISSQTYM;
	FROM REPSTOCK; 				 
	ORDER BY QUALITY,COLOUR;
	GROUP BY QUALITY,COLOUR;
	INTO CURSOR REP3
Endcase  
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wirepstockqty.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wirepstockqty.frx to printer prompt noconsole
Endcase
Endif
RETURN

