*******White Yarn Stock - White Yarn Stock Detail and Summary Report
Procedure Querygen
SET TALK OFF
SET SAFE OFF
SET DATE TO BRITI
open database carpet

CREATE CURSOR REPSTOCKY (QUALITY C(10),  NETWT N(12,3), INQTY N(12,3), ORDQTY N(12,3), RECQTY N(12,3), ISSQTY N(12,3), RCODE C(3))

*******Calculate total till date, say if start date is 3/3/2014 all data previous to this date will go to opening ok 26/10/2014 Ramesh
SELECT QUALITY,NETWT,RCODE;
FROM YRNOP;
INTO CURSOR YOP

SELECT QUALITY, SUM(NETWT) NETWT,RCODE;
FROM YRECP SHARE;  && Inter yarn received for wool given
WHERE date<msdate;
GROUP BY QUALITY;
ORDER BY QUALITY;
INTO CURSOR YRR

SELECT QUALITY, SUM(NETWT) NETWT,RCODE;
FROM YRNORDER SHARE;
WHERE date<msdate;
GROUP BY QUALITY;
ORDER BY QUALITY;
INTO CURSOR YRO

SELECT QUALITY, SUM(NETWT) NETWT,RCODE;
FROM YRNRECVD SHARE;
WHERE recdt<msdate;
GROUP BY QUALITY;
ORDER BY QUALITY;
INTO CURSOR YRD

SELECT QUALITY, SUM(Quantity) NETWT,RCODE ;
FROM YRNISSDY SHARE;
WHERE date<msdate;
GROUP BY QUALITY;
ORDER BY QUALITY;
INTO CURSOR YRI

*wistockdata, Show Quality,Colour,Netweight for Matching Quality
Do wstk
Do wrecv
Do wrtn
Do wiss
Select sum(openbal+recqty+retnqty-issqty) balance;
From Wstock;
Into Cursor Wstock1
Pbalance=Wstock1->balance

Procedure wstk
CREATE CURSOR WSTOCK (QUALITY C(10),COLOUR C(10),OPENBAL N(10,3),RECQTY N(11,3),RETNQTY N(11,3),ISSQTY N(11,3))
SELECT WSTOCK
APPEND FIELDS QUALITY,COLOUR,OPENBAL FROM WISTOCK FOR QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR
RETURN

Procedure wrecv
SELECT QUALITY,COLOUR,SUM(QUANTITY) RECQTY;
FROM WIRECV SHARE;
WHERE QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV
SELECT WSTOCK
APPEND FIELDS QUALITY,COLOUR,RECQTY FROM DBF ('RECV') FOR QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR
RETURN

Procedure wrtn
SELECT QUALITY,COLOUR,SUM(QUANTITY) RETNQTY;
FROM WIRETURN SHARE;
WHERE QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RETN
SELECT WSTOCK
APPEND FIELDS QUALITY,COLOUR,RETNQTY FROM DBF ('RETN') FOR QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR
RETURN

Procedure wiss
SELECT QUALITY,COLOUR,SUM(QUANTITY) ISSQTY;
FROM WIISSUE SHARE;
WHERE QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ISSUE
SELECT WSTOCK
APPEND FIELDS QUALITY,COLOUR,ISSQTY FROM DBF ('ISSUE') FOR QUALITY=PSQUALITY .AND. COLOUR=PSCOLOUR
RETURN


