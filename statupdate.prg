*1. Updating Exported cStatus in Cabuyord.dbf  
Select b.ol_no,b.cstatus,b.exported,p.lastatus,p.invno;
From Cabuyord b,Packtran p;
Where b.ol_no=p.ol_no .and. b.cstatus<>p.lastatus .and. b.cstatus<>'Exported';
Into Cursor stsupdt && status update

scan
update Cabuyord ;
set Cabuyord.cstatus=stsupdt.Lastatus;
Where Cabuyord.ol_no=stsupdt.ol_no
endscan
**eof**

*2.  Updating cStatus in Cabuyord.dbf taking consideration of Casupord.dbf dates Status=>UnWashed,CutIssue,IssueWash,RecdWash,
**Exclude cstatus NotDistri,Distri,On-Loom,Packed,Exported from List 6/6/2020 Ramesh
Select b.ol_no,b.cstatus,s.fdate,s.cutissdt,s.IssdtWash,s.RcddtWash;
From Cabuyord b,Casupord s;
Where b.ol_no=s.ol_no .and. b.cstatus<>'NotDistri' .and. b.cstatus<>'Distri' .and. b.cstatus<>'On-Loom' .and. b.cstatus<>'Packed' .and. b.cstatus<>'Exported';
Order by b.ol_no;
Into Cursor Supdt

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose.
USE (DBF([Supdt])) ALIAS SupdtUpdt AGAIN IN 0 SHARED
USE IN SELECT([Supdt])

SELECT SupdtUpdt
SCAN
	DO CASE
		Case !empty(fdate) .and. empty(cutissdt) .and. empty(Issdtwash).and. empty(rcddtwash)
			Repl Cstatus with 'UnWashed'
		Case !empty(fdate) .and. !empty(cutissdt) .and. empty(Issdtwash).and. empty(rcddtwash)
			Repl Cstatus with 'CutIssue' 
		Case !empty(fdate) .and. !empty(cutissdt) .and. empty(Issdtwash).and. empty(rcddtwash)
			Repl Cstatus with 'CutIssue' 
		Case !empty(fdate) .and. !empty(cutissdt) .and. !empty(Issdtwash).and. empty(rcddtwash)
			Repl Cstatus with 'IssueWash' 
		Case !empty(fdate) .and. !empty(cutissdt) .and. !empty(Issdtwash).and. !empty(rcddtwash)
			Repl Cstatus with 'RcdWash' 
		Case !empty(fdate) .and. !empty(cutissdt) .and. !empty(Issdtwash).and. empty(rcddtwash)
			Repl Cstatus with 'IssueWash' 
	ENDCASE
ENDSCAN

scan
update Cabuyord ;
set Cabuyord.cstatus=Supdtupdt.cstatus;
Where Cabuyord.ol_no=Supdtupdt.ol_no
endscan

USE IN SELECT([Supdtupdt])
