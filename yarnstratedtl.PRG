*******White Yarn Stock - White Yarn Stock Detail and Summary Report
SET DELETED ON
SET TALK OFF
SET SAFE OFF
SET DATE TO BRITI

set procedure to catool
Open Database Carpet
Do csTrimInfo4A

CREAT CURSOR REPSTK(QUALITY C(10),COLOUR C(10),OPQTY N(12,3),PURQTY N(12,3),WSHIQTY N(12,3),WSHRQTY N(12,3),ISSDYQTY N(12,3),ISSUPQTY N(12,3),RETSUPQTY N(12,3),;
PURQTYM N(12,3),WSHIQTYM N(12,3),WSHRQTYM N(12,3),ISSDYQTYM N(12,3),ISSUPQTYM N(12,3),RETSUPQTYM N(12,3), RCOD C(4), WASHTYPE C(10))
*******Calculate total till date, say if start date is 3/3/2014 all data previous to this date will go to opening ok 26/10/2014 Ramesh
*1) White Yarn Opening
SELECT QUALITY,COLOUR,NETWT,WASHTYPE,PADR('YOP1',4) as RCOD;
FROM YRNOP;
Where ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YOP

*2) White Yarn Purchase
SELECT QUALITY,COLOUR,WASHTYPE,SUM(NETWT) NETWT,PADR('YPU1',4) as RCOD;
FROM YRNRECVD;
WHERE recdt<msdate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YPU

*3) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QTY) NETWT,PADR('YWI1',4) as RCOD;
FROM YRNWSHISS ;
WHERE date<msdate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YWI

*4) White Yarn Received From Washing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QTY) NETWT,PADR('YWR1',4) as RCOD;
FROM YRNWSHRCD ;
WHERE date<msdate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YWR

*5) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QUANTITY) NETWT,PADR('YID1',4) as RCOD;
FROM YRNISSDY SHARE;
WHERE date<msdate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YID

*6) White Yarn Issue to Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,i.WASHTYPE,SUM(i.QUANTITY) NETWT,PADR('WIS1',4) as RCOD;
FROM WIISSUE i,  YRNOP j;
WHERE i.QUALITY=j.QUALITY .AND. i.COLOUR=j.COLOUR .AND. i.date<msdate .and. ccsMatch4a(i.Washtype);
GROUP BY i.Washtype,i.QUALITY,i.COLOUR;
ORDER BY i.Washtype,i.QUALITY,i.COLOUR;
INTO CURSOR WIS

*7) White Yarn Return From Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,i.WASHTYPE,SUM(i.QUANTITY) NETWT,PADR('WIR1',4) as RCOD;
FROM WIRETURN i, YRNOP j;
WHERE i.QUALITY=j.QUALITY .AND. i.COLOUR=j.COLOUR .AND. i.date<msdate .and. ccsMatch4a(i.Washtype);
GROUP BY i.Washtype,i.QUALITY,i.COLOUR;
ORDER BY i.Washtype,i.QUALITY,i.COLOUR;
INTO CURSOR WIR
*******************************************************************
*
***CALCULATE MONTH TOTAL, we are calculating inbetween data ok 26/10/2014
*2M) White Yarn Purchase
SELECT QUALITY,COLOUR,WASHTYPE,SUM(NETWT) NETWT,PADR('YPUM',4) as RCOD;
FROM YRNRECVD;
WHERE recdt>=msdate .and. recdt<=medate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YPUM

*3M) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QTY) NETWT,PADR('YWIM',4) as RCOD;
FROM YRNWSHISS ;
WHERE date>=msdate .and. date<=medate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YWIM

*4M) White Yarn Received From Washing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QTY) NETWT,PADR('YWRM',4) as RCOD;
FROM YRNWSHRCD ;
WHERE date>=msdate .and. date<=medate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YWRM

*5M) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR,WASHTYPE,SUM(QUANTITY) NETWT,PADR('YIDM',4) as RCOD;
FROM YRNISSDY SHARE;
WHERE date>=msdate .and. date<=medate .and. ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR YIDM

*6M) White Yarn Issue to Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,i.WASHTYPE,SUM(i.QUANTITY) NETWT,PADR('WISM',4) as RCOD;
FROM WIISSUE i, YRNOP j;
WHERE i.QUALITY=j.QUALITY .AND. i.COLOUR=j.COLOUR .AND. i.WASHTYPE=j.WASHTYPE .AND. i.date>=msdate .and. i.date<=medate .and. ccsMatch4a(i.Washtype);
GROUP BY i.Washtype,i.QUALITY,i.COLOUR;
ORDER BY i.Washtype,i.QUALITY,i.COLOUR;
INTO CURSOR WISM

*7M) White Yarn Return From Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,i.WASHTYPE,SUM(i.QUANTITY) NETWT,PADR('WIRM',4) as RCOD;
FROM WIRETURN i, YRNOP j;
WHERE i.QUALITY=j.QUALITY .AND. i.COLOUR=j.COLOUR  .AND. i.WASHTYPE=j.WASHTYPE .AND. i.date>=msdate .and. i.date<=medate;
GROUP BY i.Washtype,i.QUALITY,i.COLOUR;
ORDER BY i.Washtype,i.QUALITY,i.COLOUR;
INTO CURSOR WIRM
