INTO CURSOR ystk
***** distribute all data according to fields
SELECT ystk 
DO WHILE .NOT. EOF()
SELECT REPSTK
APPEN BLANK
repl quality with ystk->quality,colour with ystk->colour,rcod with ystk->rcod,washtype with ystk->washtype
do case
	case rcod='YOP1'
		repl REPSTK->OPQTY with ystk->netwt
	case rcod='YPU1'
		repl REPSTK->PURQTY with ystk->netwt
	case rcod='YWI1'
		repl  REPSTK->WSHIQTY with ystk->netwt
	case rcod='YWR1'
		repl REPSTK->WSHRQTY with ystk->netwt
	case rcod='YID1'
		repl REPSTK->ISSDYQTY with ystk->netwt
	case rcod='WIS1'
		repl REPSTK->ISSUPQTY with ystk->netwt
	case rcod='WIR1'
		repl REPSTK->RETSUPQTY with ystk->netwt
************************************************
	case rcod='YPUM'
		repl REPSTK->PURQTYM with ystk->netwt
	case rcod='YWIM'
		repl  REPSTK->WSHIQTYM with ystk->netwt
	case rcod='YWRM'
		repl REPSTK->WSHRQTYM with ystk->netwt
	case rcod='YIDM'
		repl REPSTK->ISSDYQTYM with ystk->netwt
	case rcod='WISM'
		repl REPSTK->ISSUPQTYM with ystk->netwt
	case rcod='WIRM'
		repl REPSTK->RETSUPQTYM with ystk->netwt
  endcase
   SELECT ystk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
SELECT QUALITY,COLOUR,WASHTYPE,SUM(OPQTY) OPQTY, SUM(PURQTY) PURQTY, SUM(WSHIQTY) WSHIQTY, SUM(WSHRQTY) WSHRQTY, SUM(ISSDYQTY) ISSDYQTY, SUM(ISSUPQTY) ISSUPQTY, SUM(RETSUPQTY) RETSUPQTY,;
		SUM(PURQTYM) PURQTYM, SUM(WSHIQTYM) WSHIQTYM, SUM(WSHRQTYM) WSHRQTYM, SUM(ISSDYQTYM) ISSDYQTYM, SUM(ISSUPQTYM) ISSUPQTYM, SUM(RETSUPQTYM) RETSUPQTYM;
FROM REPSTK;
Where ccsMatch4a(Washtype);
GROUP BY WASHTYPE,QUALITY,COLOUR;
ORDER BY WASHTYPE,QUALITY,COLOUR;
INTO CURSOR REPSTOCKY2

SELECT QUALITY,COLOUR,WASHTYPE,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,;
		OPQTY+PURQTY-WSHIQTY+WSHRQTY-ISSDYQTY-ISSUPQTY+RETSUPQTY+PURQTYM-WSHIQTYM+WSHRQTYM-ISSDYQTYM-ISSUPQTYM+RETSUPQTYM AS BALANCE;
FROM REPSTOCKY2;
Where ccsMatch4a(Washtype);
ORDER BY QUALITY,COLOUR;
INTO CURSOR REPSTOCKY1


****all Quality -ve,+ve all stock report
Do Case
  Case !Empty(m.QUALITY) .and. !empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,WASHTYPE,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE QUALITY=m.QUALITY .and. COLOUR=m.COLOUR .and. ccsMatch4a(Washtype);
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A
	
	SELECT r.QUALITY,r.COLOUR,r.BALANCE,w.RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE;
	INTO CURSOR REP3	

  Case !Empty(m.QUALITY)  .and. empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,WASHTYPE,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE QUALITY=m.QUALITY .and. ccsMatch4a(Washtype);
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A

	SELECT r.QUALITY,r.COLOUR,r.BALANCE,w.RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE;
	INTO CURSOR REP3		
	
  Case !empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,WASHTYPE,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE COLOUR=m.COLOUR .and. ccsMatch4a(Washtype);
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A

	SELECT r.QUALITY,r.COLOUR,r.BALANCE,w.RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE;
	INTO CURSOR REP3		

  Case Empty(m.QUALITY)  .and. empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,WASHTYPE,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE ccsMatch4a(Washtype); 
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A
	
	SELECT r.QUALITY,r.COLOUR,r.BALANCE,w.RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE;
	INTO CURSOR REP3	
Endcase  

SELECT REP3
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"	
		Report form yarnstrate.frx PREVIEW WINDOW wReport
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form yarnstrate.frx to printer prompt noconsole
	Case m.PrnStat="S"
		EXPORT TO &exclfile TYPE XL5 FIELDS QUALITY,Colour,BALANCE,RATE,DESC,YTYPE
		Messagebox("Search [Undyed Yarn Stock Summary] Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
Endcase
Endif
