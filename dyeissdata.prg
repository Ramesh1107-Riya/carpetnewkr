**Check system for Issue Washing
SET TALK OFF
SET SAFE OFF
SET DATE TO BRITI
Do Opn
Do Purch
Do WhIss 
Do WhRcd
Do IssDy
Do WiIss
Do WiRetn

Select sum(OPQTY+PURQTY-WSHIQTY+WSHRQTY-ISSDYQTY-ISSUPQTY+RETSUPQTY) as balance;
From DYEISS;
Into Cursor cDyeIsu

Select cDyeIsu
Pdbalance=cDyeIsu->balance

Procedure Opn
CREATE CURSOR DYEISS(QUALITY C(10),COLOUR C(10),OPQTY N(12,3),PURQTY N(12,3),WSHIQTY N(12,3),WSHRQTY N(12,3),ISSDYQTY N(12,3),ISSUPQTY N(12,3),RETSUPQTY N(12,3))
*1) White Yarn Opening
SELECT QUALITY,COLOUR,NETWT as OPQTY;
FROM YRNOP;
WHERE Quality=PdQuality .and. Colour=PdColour;
INTO CURSOR YOP
SELECT DYEISS
APPEN FIELDS QUALITY,COLOUR,OPQTY FROM DBF ('YOP') 
Return

Procedure Purch
*2) White Yarn Purchase
SELECT QUALITY,COLOUR,SUM(NETWT) as PURQTY;
FROM YRNRECVD;
WHERE Quality=PdQuality .and. Colour=PdColour;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YPU
SELECT DYEISS
APPEN FIELDS PURQTY FROM DBF ('YPU') 
Return

Procedure WhIss
*3) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,SUM(QTY)as WSHIQTY;
FROM YRNWSHISS;
WHERE Quality=PdQuality .and. Colour=PdColour;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWI
SELECT DYEISS
APPEN FIELDS WSHIQTY FROM DBF ('YWI') 
Return

Procedure WhRcd
*4) White Yarn Received From Washing
SELECT QUALITY,COLOUR,SUM(QTY) as WSHRQTY;
FROM YRNWSHRCD ;
WHERE Quality=PdQuality .and. Colour=PdColour;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWR
SELECT DYEISS
APPEN FIELDS WSHRQTY FROM DBF ('YWR') 
Return

Procedure IssDy
*5) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR, SUM(QUANTITY) as ISSDYQTY;
FROM YRNISSDY;
WHERE Quality=PdQuality .and. Colour=PdColour;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YID
SELECT DYEISS
APPEN FIELDS ISSDYQTY FROM DBF ('YID') 
Return

Procedure WiIss
*6) White Yarn Issue to Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) ISSUPQTY;
FROM WIISSUE;
WHERE QUALITY=PdQUALITY .AND. COLOUR=PDCOLOUR .AND. dyewht='W';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIS
SELECT DYEISS
APPEN FIELDS ISSUPQTY FROM DBF ('WIS') 
Return

Procedure WiRetn
*7) White Yarn Return From Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) RETSUPQTY;
FROM WIRETURN;
WHERE QUALITY=PDQUALITY .AND. COLOUR=PDCOLOUR .AND. dyewht='W';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIR
SELECT DYEISS
APPEN FIELDS RETSUPQTY FROM DBF ('WIR') 
Return