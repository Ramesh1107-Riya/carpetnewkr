*Carpet Progress Report made from Order Not Distributed Report- for this required fileds are little more
SET DELETED ON
Set talk off
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

SET PROCEDURE TO CATOOL
DO csTrimInfo      && Trim Information for Check Purpose !
Open Database Carpet

SELECT BCODE, PO_NO, PO_DT, CTRL_NO, OL_NO, QUALITY, DESIGN, SZCODE, COLOUR, FIELDCODE,;
 	WASHTYPE, SPCL_INST, COMMENT, b.CSTATUS, ORDER_TYPE, CTYPE, SQMT, DELIRY_DT,QTY,c.GSTATUS;
FROM  Carpet!Cabuyord b, CSTATUS c;
WHERE c.status=b.cstatus .AND. PO_DT>=m.Startdt .and. PO_DT<=m.Enddt;
INTO CURSOR BUYSTATUS

SELECT BCODE, PO_NO, PO_DT, CTRL_NO, OL_NO, QUALITY, DESIGN, SZCODE, COLOUR, FIELDCODE,;
 	WASHTYPE, SPCL_INST, COMMENT,CSTATUS, ORDER_TYPE, CTYPE, SUM(SQMT) AS SQMT, DELIRY_DT,SUM(QTY) AS QTY,GSTATUS;
FROM  BUYSTATUS;
WHERE ccsMatch6a(BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR);
ORDER BY PO_NO,Design,szcode,Quality,Deliry_Dt;
Group By PO_NO,Design,szcode,Quality,GSTATUS;
INTO CURSOR CAPROGRES

SELECT OL_NO,DESIGN,SZCODE,GSTATUS,PO_NO,PO_DT,COLOUR,DELIRY_DT,QUALITY,SQMT,SQMT*0 AS PNsqmt,SQMT*0 AS RDsqmt,SQMT*0 AS PKsqmt,SQMT*0 AS EXsqmt,;
			QTY*0 AS PNqty,QTY*0 AS RDqty,QTY*0 AS PKqty,QTY*0 AS EXqty;
FROM CAPROGRES;
ORDER BY PO_NO,Design,szcode,DELIRY_DT;
INTO CURSOR cTemp1 

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose. Cursor CAPROGRESDITN (R/W)
*****************************
USE (DBF([cTemp1])) ALIAS CAPROGRESDITN01 AGAIN IN 0 share
USE IN cTemp1

*SELECT CAPROGRESDITN01
*Index on Design+Szcode+Po_no+Colour+gstatus to dspc1

***** distribute all data according to fields
SELECT CAPROGRES
*Index on Design+Szcode+Po_no+Colour+gstatus to dspc2
*Set Order to dspc2
DO WHILE .NOT. EOF()
SELECT CAPROGRESDITN01
*SET ORDER TO dspc1
Locate for ol_no=Caprogres->ol_no
do case
	case CAPROGRES->GSTATUS='PRODUCTN'
		repl CAPROGRESDITN01->PNsqmt with CAPROGRES->sqmt,CAPROGRESDITN01->PNqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='READY'
		repl CAPROGRESDITN01->RDsqmt with CAPROGRES->sqmt,CAPROGRESDITN01->RDqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='PACKED'
		repl CAPROGRESDITN01->PKsqmt with CAPROGRES->sqmt,CAPROGRESDITN01->PKqty with CAPROGRES->Qty
	case CAPROGRES->GSTATUS='EXPORTED'
		repl CAPROGRESDITN01->EXsqmt with CAPROGRES->sqmt,CAPROGRESDITN01->EXqty with CAPROGRES->Qty
  endcase
   SELECT CAPROGRES
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO


SELECT DESIGN,SZCODE,GSTATUS,PO_NO,PO_DT,COLOUR,DELIRY_DT,QUALITY,sum(PNsqmt) As pnsqmt,sum(RDsqmt) As rdsqmt,sum(PKsqmt) As pksqmt,;
	 sum(EXsqmt) As exsqmt, sum(PNqty) As pnqty, sum(RDqty) As rdqty, sum(PKqty) As pkqty,sum(EXqty) As exqty;
From CAPROGRESDITN01;
Group By PO_NO,Design,szcode,Quality,Deliry_Dt;
Order by DELIRY_DT;
Into  Cursor CaProgRep

Select CaProgRep
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V" .and. m.Option="A" 
		Report form caprogressum.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P" .and. m.Option="B" 
		Report form caprogressum.frx to printer prompt noconsole
	Case  m.PrnStat="V" .and. m.Option="C"  
		EXPORT TO &exclfile TYPE XL5 FIELDS DESIGN,SZCODE,GSTATUS,PO_NO,PO_DT,COLOUR,DELIRY_DT,QUALITY,pnsqmt,rdsqmt,pksqmt,;
	    exsqmt, pnqty, rdqty, pkqty, exqty
 	Messagebox("Search Non Distributed Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
Endcase
Endif
USE IN CAPROGRESDITN01
*UNLOCK ALL

Return
