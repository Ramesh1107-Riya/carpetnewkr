SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _46u0p57pq OF _MSYSMENU PROMPT "Setup" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _46u0p57pr OF _MSYSMENU PROMPT "Data Entry" COLOR SCHEME 3 ;
	KEY ALT+D, ""
DEFINE PAD _46u0p57ps OF _MSYSMENU PROMPT "Report" COLOR SCHEME 3 ;
	KEY ALT+R, ""
DEFINE PAD _46u0p57pt OF _MSYSMENU PROMPT "Exit" COLOR SCHEME 3 ;
	KEY ALT+E, ""
ON PAD _46u0p57pq OF _MSYSMENU ACTIVATE POPUP setup
ON PAD _46u0p57pr OF _MSYSMENU ACTIVATE POPUP dataentry
ON PAD _46u0p57ps OF _MSYSMENU ACTIVATE POPUP report
ON SELECTION PAD _46u0p57pt OF _MSYSMENU do endprg

DEFINE POPUP setup MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF setup PROMPT "New Wool Quality"
DEFINE BAR 2 OF setup PROMPT "Dye House Name"
DEFINE BAR 3 OF setup PROMPT "Store Location"
DEFINE BAR 4 OF setup PROMPT "Order By"
DEFINE BAR 5 OF setup PROMPT "Wool Store Opening"
DEFINE BAR 6 OF setup PROMPT "Yarn Store Opening"
DEFINE BAR 7 OF setup PROMPT "Yarn Supplier Opening"
ON SELECTION BAR 1 OF setup do form woolqlty
ON SELECTION BAR 2 OF setup do form dyehouse
ON SELECTION BAR 3 OF setup do form location
ON SELECTION BAR 4 OF setup do form orderby
ON SELECTION BAR 5 OF setup do form woolop
ON SELECTION BAR 6 OF setup do form yrnop
ON SELECTION BAR 7 OF setup do form yrsupop

DEFINE POPUP dataentry MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF dataentry PROMPT "Raw Wool"
DEFINE BAR 2 OF dataentry PROMPT "White Yarn"
ON BAR 1 OF dataentry ACTIVATE POPUP rawwool
ON BAR 2 OF dataentry ACTIVATE POPUP whiteyarn

DEFINE POPUP rawwool MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF rawwool PROMPT "Wool Purchase"
DEFINE BAR 2 OF rawwool PROMPT "Wool Issue"
ON SELECTION BAR 1 OF rawwool do form woolpu
ON SELECTION BAR 2 OF rawwool do form woolissu

DEFINE POPUP whiteyarn MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF whiteyarn PROMPT "Yarn Recd Int. Supplier"
DEFINE BAR 2 OF whiteyarn PROMPT "Raw Material Order"
DEFINE BAR 3 OF whiteyarn PROMPT "Raw Material Purchase"
DEFINE BAR 4 OF whiteyarn PROMPT "Yarn Issue to Dyeing"
ON SELECTION BAR 1 OF whiteyarn do form yrecp
ON SELECTION BAR 2 OF whiteyarn do form yrnorder
ON SELECTION BAR 3 OF whiteyarn do form yrnrecvd
ON SELECTION BAR 4 OF whiteyarn do form yrnissdy

DEFINE POPUP report MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF report PROMPT "Raw Material order"
DEFINE BAR 2 OF report PROMPT "Wool Report"
DEFINE BAR 3 OF report PROMPT "Yarn Report"
DEFINE BAR 4 OF report PROMPT "Stock Report"
ON SELECTION BAR 1 OF report do form yrnorderep
ON BAR 2 OF report ACTIVATE POPUP woolreport
ON BAR 3 OF report ACTIVATE POPUP yarnreport
ON BAR 4 OF report ACTIVATE POPUP stockrepor

DEFINE POPUP woolreport MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF woolreport PROMPT "Wool Purchase"
DEFINE BAR 2 OF woolreport PROMPT "Wool Issue"
DEFINE BAR 3 OF woolreport PROMPT " "
ON SELECTION BAR 1 OF woolreport do form woolpurep
ON SELECTION BAR 2 OF woolreport do form woolissrep

DEFINE POPUP yarnreport MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF yarnreport PROMPT "Yarn Recd due to Wool"
DEFINE BAR 2 OF yarnreport PROMPT "Yarn Purchase"
DEFINE BAR 3 OF yarnreport PROMPT "Yarn Issue to Dyeing"
ON SELECTION BAR 2 OF yarnreport do form yrnpurep
ON SELECTION BAR 3 OF yarnreport do form yrdyeisrep

DEFINE POPUP stockrepor MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF stockrepor PROMPT "Wool Stock Rep"
DEFINE BAR 2 OF stockrepor PROMPT "Yarn Stock Rep"
ON SELECTION BAR 1 OF stockrepor do form woolstkrep
ON SELECTION BAR 2 OF stockrepor do form yarnstkrep
