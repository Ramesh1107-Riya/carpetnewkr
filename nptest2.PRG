SELECT QUALITY,COLOUR,NETWT,PADR('YOP1',4) as RCOD;
FROM YRNOP;
INTO CURSOR YOP

*2) White Yarn Purchase
SELECT QUALITY,COLOUR,SUM(NETWT) NETWT,PADR('YPU1',4) as RCOD;
FROM YRNRECVD;
WHERE recdt<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YPU

*3) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YWI1',4) as RCOD;
FROM YRNWSHISS ;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWI

*4) White Yarn Received From Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YWR1',4) as RCOD;
FROM YRNWSHRCD ;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWR

*5) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR, SUM(QUANTITY) NETWT,PADR('YID1',4) as RCOD;
FROM YRNISSDY SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YID

*6) White Yarn Issue to Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) NETWT,PADR('WIS1',4) as RCOD;
FROM WIISSUE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIS

*7) White Yarn Return From Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) NETWT,PADR('WIR1',4) as RCOD;
FROM WIRETURN;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIR


SELECT p.QUALITY,p.COLOUR,p.NETWT,d.NETWT,q.QTY,c.QTY,i.QUANTITY,j.QUANTITY,K.QUANTITY;
FROM YRNOP p;
LEFT OUTER JOIN YRNRECVD d;
	ON p.Colour=d.Colour .and. p.Quality=d.Quality;
LEFT OUTER JOIN YRNWSHISS q;
	ON p.Colour=q.Colour .and. p.Quality=q.Quality;
LEFT OUTER JOIN YRNWSHRCD c;
	ON p.Colour=c.Colour .and. p.Quality=c.Quality;
LEFT OUTER JOIN YRNISSDY i;
	ON p.Colour=i.Colour .and. p.Quality=i.Quality;
LEFT OUTER JOIN WIISSUE j;
	ON p.Colour=j.Colour .and. p.Quality=j.Quality;
LEFT OUTER JOIN WIRETURN k;
	ON p.Colour=k.Colour .and. p.Quality=k.Quality;

