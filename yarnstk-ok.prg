*******White Yarn Stock - White Yarn Stock Detail and Summary Report
Procedure Querygen
SET TALK OFF
SET SAFE OFF
SET DATE TO BRITI
open database carpet

CREAT CURSOR REPSTK(QUALITY C(10),COLOUR C(10),OPQTY N(12,3),PURQTY N(12,3),WSHIQTY N(12,3),WSHRQTY N(12,3),ISSDYQTY N(12,3),ISSUPQTY N(12,3),RETSUPQTY N(12,3),;
PURQTYM N(12,3),WSHIQTYM N(12,3),WSHRQTYM N(12,3),ISSDYQTYM N(12,3),ISSUPQTYM N(12,3),RETSUPQTYM N(12,3), RCOD C(4))
*******Calculate total till date, say if start date is 3/3/2014 all data previous to this date will go to opening ok 26/10/2014 Ramesh
*1) White Yarn Opening
SELECT QUALITY,COLOUR,NETWT,PADR('YOP1',4) as RCOD;
FROM YRNOP;
INTO CURSOR YOP

*2) White Yarn Purchase
SELECT QUALITY,COLOUR,SUM(NETWT) NETWT,PADR('YPU1',4) as RCOD;
FROM YRNRECVD;
WHERE recdt<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YPU

*3) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YWI1',4) as RCOD;
FROM YRNWSHISS ;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWI

*4) White Yarn Received From Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YWR1',4) as RCOD;
FROM YRNWSHRCD ;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWR

*5) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR, SUM(QUANTITY) NETWT,PADR('YID1',4) as RCOD;
FROM YRNISSDY SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YID

*6) White Yarn Issue to Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,SUM(i.QUANTITY) NETWT,PADR('WIS1',4) as RCOD;
FROM WIISSUE i, YRNOP j;
WHERE WHERE i.QUALITY=j.QUALITY .and. i.COLOUR=j.COLOUR .and. date<msdate;
GROUP BY i.QUALITY,i.COLOUR;
ORDER BY i.QUALITY,i.COLOUR;
INTO CURSOR WIS

*7) White Yarn Return From Supplier where Wash='N'
SELECT i.QUALITY,i.COLOUR,SUM(i.QUANTITY) NETWT,PADR('WIR1',4) as RCOD;
FROM WIRETURN i,YRNOP j;
WHERE WHERE i.QUALITY=j.QUALITY .and. i.COLOUR=j.COLOUR .and. date<msdate;
GROUP BY i.QUALITY,i.COLOUR;
ORDER BY i.QUALITY,i.COLOUR;
INTO CURSOR WIR
*******************************************************************
*
***CALCULATE MONTH TOTAL, we are calculating inbetween data ok 26/10/2014
*2M) White Yarn Purchase
SELECT QUALITY,COLOUR,SUM(NETWT) NETWT,PADR('YPUM',4) as RCOD;
FROM YRNRECVD;
WHERE recdt>=msdate .and. recdt<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YPUM

*3M) White Yarn Issue to Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YPUM',4) as RCOD;
FROM YRNWSHISS ;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWIM

*4M) White Yarn Received From Washing
SELECT QUALITY,COLOUR,SUM(QTY) NETWT,PADR('YWRM',4) as RCOD;
FROM YRNWSHRCD ;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YWRM

*5M) White Yarn Issue to Dyeing
SELECT QUALITY,COLOUR, SUM(QUANTITY) NETWT,PADR('YIDM',4) as RCOD;
FROM YRNISSDY SHARE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR YIDM

*6M) White Yarn Issue to Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) NETWT,PADR('WISM',4) as RCOD;
FROM WIISSUE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WISM

*7M) White Yarn Return From Supplier where Wash='N'
SELECT QUALITY,COLOUR,SUM(QUANTITY) NETWT,PADR('WIRM',4) as RCOD;
FROM WIRETURN;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WIRM
********************************************************
*---all data in same container distinguished by rcode
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YOP;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YPU;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YWI;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YWR;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YID;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM WIS;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM WIR;  
INTO CURSOR STK1
**********************************************************
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YPUM;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YWIM;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YWRM;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM YIDM;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM WISM;
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM WIRM;
INTO CURSOR STK2
************************************************************
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM STK1; 
UNION ALL;
SELECT QUALITY,COLOUR,NETWT,RCOD;
FROM STK2; 
INTO CURSOR ystk
***** distribute all data according to fields
SELECT ystk 
DO WHILE .NOT. EOF()
SELECT REPSTK
APPEN BLANK
repl quality with ystk->quality,colour with ystk->colour,rcod with ystk->rcod
do case
	case rcod='YOP1'
		repl REPSTK->OPQTY with ystk->netwt
	case rcod='YPU1'
		repl REPSTK->PURQTY with ystk->netwt
	case rcod='YWI1'
		repl  REPSTK->WSHIQTY with ystk->netwt
	case rcod='YWR1'
		repl REPSTK->WSHRQTY with ystk->netwt
	case rcod='YID1'
		repl REPSTK->ISSDYQTY with ystk->netwt
	case rcod='WIS1'
		repl REPSTK->ISSUPQTY with ystk->netwt
	case rcod='WIR1'
		repl REPSTK->RETSUPQTY with ystk->netwt
************************************************
	case rcod='YPUM'
		repl REPSTK->PURQTYM with ystk->netwt
	case rcod='YWIM'
		repl  REPSTK->WSHIQTYM with ystk->netwt
	case rcod='YWRM'
		repl REPSTK->WSHRQTYM with ystk->netwt
	case rcod='YIDM'
		repl REPSTK->ISSDYQTYM with ystk->netwt
	case rcod='WISM'
		repl REPSTK->ISSUPQTYM with ystk->netwt
	case rcod='WIRM'
		repl REPSTK->RETSUPQTYM with ystk->netwt
  endcase
   SELECT ystk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
SELECT QUALITY,COLOUR,SUM(OPQTY) OPQTY, SUM(PURQTY) PURQTY, SUM(WSHIQTY) WSHIQTY, SUM(WSHRQTY) WSHRQTY, SUM(ISSDYQTY) ISSDYQTY, SUM(ISSUPQTY) ISSUPQTY, SUM(RETSUPQTY) RETSUPQTY,;
		SUM(PURQTYM) PURQTYM, SUM(WSHIQTYM) WSHIQTYM, SUM(WSHRQTYM) WSHRQTYM, SUM(ISSDYQTYM) ISSDYQTYM, SUM(ISSUPQTYM) ISSUPQTYM, SUM(RETSUPQTYM) RETSUPQTYM;
FROM REPSTK;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR REPSTOCKY2

SELECT QUALITY,COLOUR,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,;
		OPQTY+PURQTY-WSHIQTY+WSHRQTY-ISSDYQTY-ISSUPQTY+RETSUPQTY+PURQTYM-WSHIQTYM+WSHRQTYM-ISSDYQTYM-ISSUPQTYM+RETSUPQTYM AS BALANCE;
FROM REPSTOCKY2;
ORDER BY QUALITY,COLOUR;
INTO CURSOR REPSTOCKY1
RETURN
**END OF Querygen
****all Quality -ve,+ve all stock report
Procedure Detailrep
Do Case
  Case !Empty(m.QUALITY) .and. !empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE QUALITY=m.QUALITY .and. COLOUR=m.COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3

  Case !Empty(m.QUALITY)  .and. empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE QUALITY=m.QUALITY;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
	
  Case Empty(m.QUALITY)  .and. !empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	WHERE COLOUR=m.COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3

  Case Empty(m.QUALITY)  .and. empty(m.Colour) .and.  m.chk1=0 
	SELECT QUALITY,COLOUR,OPQTY,PURQTY,WSHIQTY,WSHRQTY,ISSDYQTY,ISSUPQTY,RETSUPQTY,PURQTYM,WSHIQTYM,WSHRQTYM,ISSDYQTYM,ISSUPQTYM,RETSUPQTYM,BALANCE;
	FROM REPSTOCKY1;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
Endcase  
SELECT REP3
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form yarnstk.frx PREVIEW WINDOW wReport
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form yarnstk.frx to printer prompt noconsole
Endcase
Endif
RETURN

**** Qualitywise Report
Procedure SummaryRep
Do Case
Case Empty(m.QUALITY) .and. empty(m.Colour) 
	SELECT QUALITY,COLOUR,sum(OPQTY) opqty,sum(PURQTY) purqty,sum(WSHIQTY) wshiqty,sum(WSHRQTY) wshrqty,sum(ISSDYQTY) issdyqty,sum(ISSUPQTY) issupqty,sum(RETSUPQTY) retsupqty,;
	sum(PURQTYM) purqtym,sum(WSHIQTYM) wshiqtym,sum(WSHRQTYM) wshrqtym,sum(ISSDYQTYM) issdyqtym,sum(ISSUPQTYM) issupqtym, sum(RETSUPQTYM) retsupqtym,sum(BALANCE) balance;
	FROM REPSTOCKY1;
	GROUP BY QUALITY;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
Case !Empty(m.QUALITY)  	
	SELECT QUALITY,COLOUR,sum(OPQTY) opqty,sum(PURQTY) purqty,sum(WSHIQTY) wshiqty,sum(WSHRQTY) wshrqty,sum(ISSDYQTY) issdyqty,sum(ISSUPQTY) issupqty,sum(RETSUPQTY) retsupqty,;
	sum(PURQTYM) purqtym,sum(WSHIQTYM) wshiqtym,sum(WSHRQTYM) wshrqtym,sum(ISSDYQTYM) issdyqtym,sum(ISSUPQTYM) issupqtym, sum(RETSUPQTYM) retsupqtym,sum(BALANCE) balance;
	FROM REPSTOCKY1;
	WHERE QUALITY=m.QUALITY;
	GROUP BY QUALITY;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
Endcase
SELECT REP3
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		*Report form yarnstk.frx to console preview in screen
		Report form yarnstksmry.frx PREVIEW WINDOW wReport
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form yarnstksmry.frx to printer prompt noconsole
Endcase
Endif
RETURN




