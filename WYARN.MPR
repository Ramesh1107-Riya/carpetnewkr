SET SYSMENU TO
SET SYSMENU AUTOMATIC

DEFINE PAD _7lz0sknvx OF _MSYSMENU PROMPT "Systerm Setup" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _7lz0sknvy OF _MSYSMENU PROMPT "Data Entry" COLOR SCHEME 3 ;
	KEY ALT+D, ""
DEFINE PAD _7lz0sknvz OF _MSYSMENU PROMPT "Report" COLOR SCHEME 3 ;
	KEY ALT+R, ""
DEFINE PAD _7lz0sknw0 OF _MSYSMENU PROMPT "System Utilities" COLOR SCHEME 3 ;
	KEY ALT+S, ""
DEFINE PAD _7lz0sknw1 OF _MSYSMENU PROMPT "Exit" COLOR SCHEME 3 ;
	KEY ALT+E, ""
ON PAD _7lz0sknvx OF _MSYSMENU ACTIVATE POPUP systermset
ON PAD _7lz0sknvy OF _MSYSMENU ACTIVATE POPUP dataentry
ON PAD _7lz0sknvz OF _MSYSMENU ACTIVATE POPUP report
ON PAD _7lz0sknw0 OF _MSYSMENU ACTIVATE POPUP newitem
ON SELECTION PAD _7lz0sknw1 OF _MSYSMENU do closeall in errutil

DEFINE POPUP systermset MARGIN RELATIVE SHADOW COLOR SCHEME 4
DEFINE BAR 1 OF systermset PROMPT "Wool Quality"
DEFINE BAR 2 OF systermset PROMPT "Yarn Quality"
DEFINE BAR 3 OF systermset PROMPT "Supplier Name"
DEFINE BAR 4 OF systermset PROMPT "Store Location"
DEFINE BAR 5 OF systermset PROMPT "Opening"
ON SELECTION BAR 1 OF systermset do form woolqlty
ON SELECTION BAR 2 OF systermset do form wiqlty
ON SELECTION BAR 3 OF systermset do form casupplr
ON SELECTION BAR 4 OF systermset do form location
ON BAR 5 OF systermset ACTIVATE POPUP _47c0t5win

