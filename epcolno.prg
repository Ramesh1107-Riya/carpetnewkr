*Stock Report, UnWashed+Issued Washed+Recd Wash - Exported  (chek validity)
Private m.DtFormat,m.ExpPkIncl
SET TALK OFF
SET SAFE OFF
SET PROCEDURE TO Catool

DO csTrimInfo      && Trim Information for Check Purpose !
Open Database Carpet
If m.Option2='AmeriDate'
	m.DtFormat='American Date Format'
	SET DATE TO AMERICAN
Else
	m.DtFormat='British Date Format'
	SET DATE TO BRITISH
Endif

Select alltrim(a) as ol_no,recno() as slno;
From  epcOlNo;
Where !empty(a);
Into table epcOlNo1a

*Select alltrim(str(ol_no)) as ol_no,slno;
*From epcOlNo1a;
*Into table epcOlNo1

Select ol_no,slno;
From epcOlNo1a;
Into table epcOlNo1

Select e.slno,Bcode,po_no,po_dt,notes,spcl_inst,WashType,b.ol_no,Cstatus,Ctrl_No,Yrncaldt as Deli_dt,Design,Quality,Colour+padr('',7) as colour,Szcode,breadth,length,sqmt,PADR('',12) as NewEpc,ORDER_TYPE,FIELDCODE,COMMENT,CTYPE;
From cabuyord b;
Right Join epcOlNo1 e;
ON b.ol_no = e.ol_no;  && a is imported serial 
Union all;
Select e.slno,Bcode,po_no,po_dt,substr(notes,1,20) as notes,spcl_inst,WashType,b.ol_no,Cstatus,Ctrl_No,Yrncaldt as Deli_dt,Design,Quality,Colour,Szcode,breadth,length,sqmt,PADR('',12) as NewEpc,ORDER_TYPE,FIELDCODE,COMMENT,CTYPE ;
From stkcarpet b;
Right Join epcOlNo1 e;
ON b.ol_no = e.ol_no; && a is imported serial
Into Cursor EpcDat1a 

Select slno,b.Bcode,po_no,po_dt,notes,spcl_inst,b.WashType,name,ol_no,Cstatus,ctrl_no,Deli_dt,Design,quality,colour,Szcode,breadth,length,sqmt,NewEpc,ORDER_TYPE,FIELDCODE,COMMENT,CTYPE ;
From EpcDat1a b;
Join Cabuyer e;
ON b.Bcode=e.bcode; && a is imported serial 
order by slno;
Into Cursor EpcDat1

Select b.slno,Bcode,po_no,po_dt,notes,spcl_inst,e.WashType,name,b.ol_no,Cstatus,Ctrl_No,Deli_dt,Design,quality,colour,Szcode,breadth,length,sqmt,NewEpc,ORDER_TYPE,FIELDCODE,COMMENT,CTYPE ;
From epcOlNo1 b; &&original Imported data ol_no
Left Join EpcDat1 e;
ON b.ol_no = e.ol_no; && a is imported ol_no
order by b.slno;
Into Cursor EpcDat


*******************************************************
*Implement This Concept
*ol_no	cstatus	serial	Deli_Dt	New EPC	Invno	InvDt	Mode	Name	Compname							
										
*ol_no	Cstatus	Ctrl_No	YrnCalDt	New EPC	invno	invdt	ship_inst	Name	Compname2	

*A)	Deli_Dt>=TodayDt() .and. (Cstatus<>'Exported' .OR. Cstatus<>'Packed'	
*		New EPC=Deli_Dt						
							
*	Deli_Dt=<TodayDt() .and. (Cstatus<>'Exported' .OR. Cstatus<>'Packed')						
*			New EPC=TodayDt()+18		
							
*B)	Deli_Dt<=TodayDt() .and. Cstatus='Packed'						
*		New EPC=TodayDt+5					
							
*	Deli_Dt=<TodayDt() .and.  Cstatus='Exported'						
*		New EPC='Sent'		

*expackingnp.dbf					
*Stkcarpet.dbf					
*Cabuyord.dbf					
*EpcSlno.dbf	=> Imported Created From Excel with field 'A'				
**********************Star Update Process***************************************
* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose.
* Order of Update is important
USE (DBF([EpcDat])) ALIAS EpcDatNew AGAIN IN 0 SHARED
USE IN SELECT([EpcDat])
*1)
update EpcDatNew;
Set NewEpc='Sent';
Where Cstatus='Exported'  && Exported implemented
*2)
update EpcDatNew;
Set NewEpc=DTOC(Date()+5);
Where Cstatus='Packed'  && Pack implemented
*3)
update EpcDatNew;
Set NewEpc=Alltrim(Name);
Where Empty(NewEpc) .and. (name='GRADE' .OR. name='HOLD' .OR. name='TEMP')&& Grade Update
*4)
update EpcDatNew;
Set NewEpc=DTOC(Date()+18);  && Convert Date to Character
Where Empty(NewEpc) .and. Deli_Dt<=Date()   && Late Deli_Dt
*5)
update EpcDatNew;
Set NewEpc=DTOC(Deli_Dt); 
Where Empty(NewEpc) .and. Deli_Dt>=Date()  && On Time Deli_Dt and Deli_Dt more than 7 days
**********eof Update Process********************
Select i.*,j.invno;
From EpcDatNew i;
Left Join Packtran j;
ON i.ol_no=j.ol_no;
Into Cursor EpcDatNew1

Select i.*,j.invdt,j.ship_inst,Alltrim(j.Name) as Buyer,Alltrim(j.Compname2) as Company;
From EpcDatNew1 i;
Left Join expackingnp j;
ON i.invno=j.invno;
Into Cursor EpcDatNew2

Select slno,Bcode,po_no,po_dt,notes,spcl_inst,WashType,ol_no,Cstatus,Ctrl_No,Deli_dt,Design,quality,colour,Szcode,breadth,length,sqmt,NewEpc,;
		iif(isnull(invno),'              ',invno)as invno,iif(isnull(invdt),{},invdt)as invdt,iif(Isnull(ship_inst),'   ',ship_inst) as ship_inst,;
	iif(ISnull(Buyer),'                        ',Buyer) as Buyer,iif(Isnull(Company),'                 ',Company) as Company,ORDER_TYPE,FIELDCODE,COMMENT,CTYPE;
From EpcDatNew2;
Into Cursor EpcDatNew3

IF m.DoNotSrchExp=.F.  && exclude Exported Carpet
	m.ExpPkIncl='Exported & Packing Included'
	SELECT *;
	FROM EpcDatNew3;
	WHERE ccsMatch6(BCODE,PO_NO,CTRL_NO,OL_NO,QUALITY,DESIGN,SZCODE,COLOUR,ORDER_TYPE,FIELDCODE,WASHTYPE,SPCL_INST,COMMENT,CSTATUS,CTYPE );
	Order by slno;
	Into Cursor Epc1
	
	SELECT s.supplier,a.slno,a.ol_no,a.Bcode,a.po_no,a.po_dt,a.notes,a.spcl_inst,a.WashType,a.Cstatus,a.Ctrl_No,a.Deli_dt,a.Design,a.quality,a.colour,a.Szcode,a.breadth,a.length,;
			a.sqmt,a.NewEpc,a.invno,a.invdt,a.ship_inst,a.Buyer,a.Company,s.issdtwash,s.rcddtwash,s.wev_cm,s.wev_cmdt;
	FROM Epc1 a;
	Left Join casupord s;
	on a.ol_no=s.ol_no;
	Order by a.slno;
	Into Cursor Epc	
Else
	m.ExpPkIncl='Exported & Packing [NOT] Included'
	SELECT *;
	FROM EpcDatNew3;
	WHERE ccsMatch6(BCODE,PO_NO,CTRL_NO,OL_NO,QUALITY,DESIGN,SZCODE,COLOUR,ORDER_TYPE,FIELDCODE,WASHTYPE,SPCL_INST,COMMENT,CSTATUS,CTYPE ) .AND. CSTATUS<>'Exported' .AND. CSTATUS<>'Packed';
	Order by slno;
	Into Cursor Epc1
	
	SELECT s.supplier,a.slno,a.ol_no,a.Bcode,a.po_no,a.po_dt,a.notes,a.spcl_inst,a.WashType,a.Cstatus,a.Ctrl_No,a.Deli_dt,a.Design,a.quality,a.colour,a.Szcode,a.breadth,a.length,;
			a.sqmt,a.NewEpc,a.invno,a.invdt,a.ship_inst,a.Buyer,a.Company,s.issdtwash,s.rcddtwash,s.wev_cm,s.wev_cmdt;
	FROM Epc1 a;
	Left Join casupord s;
	on a.ol_no=s.ol_no;
	Order by a.slno;
	Into Cursor Epc	
Endif

*ORDER_TYPE,FIELDCODE,COMMENT,CTYPE 
Select Epc
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V" .and. m.Option="A"
		Report form epcrep.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P" .and. m.Option="B"
		Report form epcrep.frx to printer prompt noconsole
	Case  m.PrnStat="V" .and. m.Option="E" 
		?SYS(5)+CURDIR()
		CD EXCELFILES
		EXPORT TO &exclfile TYPE XL5 FIELDS po_no,ol_no,Design,colour,quality,breadth,length,sqmt,notes,Ctrl_No,Cstatus,po_dt,Deli_dt,NewEpc,invno,invdt,spcl_inst,WashType,ship_inst,Buyer,Company,Supplier,issdtwash,rcddtwash,wev_cm,wev_cmdt,slno
		Messagebox("Search EPC Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
		CD.. 
	Endcase
Endif
USE IN EpcDatNew
USE IN epcolno
