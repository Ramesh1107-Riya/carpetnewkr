**Printing Selected Labels by [Y]

Open Database Carpet share
SELECT p.buyerno,p.subbuyer,d.dgndesc as Design,p.colour,p.shipbrth as bthweav,p.shiplngth as lthweav,p.baleno,p.slno;
FROM packtran p,Cadesign d ;
Where p.Design=d.Code;
Having p.invno=alltrim(m.invno);
Into Cursor temp1a

SELECT p.buyerno,p.subbuyer,p.Design,d.Desc as colour,p.bthweav,p.lthweav,p.baleno,p.slno;
FROM temp1a p,CaColour d ;
Where p.colour=d.Code;
Order by p.bthweav,p.slno,p.Design,d.Desc;
Into Cursor temp1


SELECT *, .f. as label; && a logical field Label is added to cursor cLabel
FROM temp1 ;
ORDER BY slno;
INTO CURSOR cLabel

IF RECCOUNT("cLabel") <= 0
  ?? CHR(7)
  WAIT WINDOW "No Matching Records found ..." TIMEOUT 1
  RETURN 0
ENDIF


* CURSOR Generated by SELECT SQL is Read-Only
* We need to make, another Cursor for Read-Write purpose.

SELECT *;
FROM cLabel;
ORDER BY slno;
INTO CURSOR cTemp NOFILTER

USE (DBF([cTemp])) ALIAS rwLabel AGAIN IN 0 SHARED
USE IN SELECT([cTemp])

*****************
PRIVATE  m.csVar1,m.csVar2,m.csVar9,mfdate
m.csVar3=.T.
m.csVar4=.F.

* Now Display ALL the Found Records and allow the user to Mark them for Printing

*SET COLOR TO
DEFINE WINDOW csoSrchWn_ FROM 02,00 TO 50,112 IN SCREEN DOUBLE NOCLOSE ;
  NOFLOAT NOGROW NOZOOM TITLE "Print Selected Lables, [Y] to Select - and Press [F10] To Print, [Esc] to Exit " COLOR SCHEME 10 && you can get better this color tested 11/5/10
?? CHR(7)

*DO MessDisplay WITH "Mark for Distribution with [Y] - and press [F10] when Done     [ESC]= Exit"
WAIT WINDOW ALLTRIM(STR(RECCOUNT("cLabel"))) + " Matching Pieces Found !" NOWAIT
USE IN cLabel

SELECT rwLabel
REPLACE ALL LABEL      WITH .F.
GO TOP
INDEX ON Slno TAG Slnondx
SET ORDER TO Slnondx
m.csVar9  = ON("KEY", "F10")
ON KEY LABEL F10     KEYBOARD CHR(23)

BROWSE FIELDS LABEL:H="Print?":P="Y":8, Baleno:H="Bale No":10:R,Buyerno:H="Order No.":20:R,Design:H="Design":20:R,Colour:H="Colour":12:R,;
   bthweav:H="Breadth":8:R,lthweav:H="Length":7:R,Subbuyer:H="Sub Buyer":20:R REST FREEZE LABEL NOAPPEND NODELETE NOMENU;
  TITLE "Select Label to Print by pressing [Y] and Press [F10] For Print,  [Esc] to Exit" WINDOW ;
  csoSrchWn_  COLOR SCHEME 10 && test 11/5/10 this is best color in color scheme
 
m.csVar1  = LASTKEY()
ON KEY LABEL F10   &csVar9

Select rwLabel
SET FILTER TO LABEL
*********Printing
  SET COLOR TO
	If RECNO()>RECCOUNT()
		Messagebox("Record Not Found for the above seletion!!!")
	Else
		Do Case
			Case m.PrnStat="V"
				Label form label1.lbx to console preview in screen
			Case m.PrnStat="P"
				Label form label1.lbx to printer prompt noconsole
		Endcase
	Endif
*********end print
  
IF m.csVar1 = 23     && F10 Pressed: ask other Inputs to Record !
  COUNT TO m.csVar1  FOR LABEL
  IF m.csVar1 <= 0
    ?? CHR(7)
    WAIT WINDOW "No Pieces Marked for Distribution !!" TIMEOUT 2
    USE IN rwLabel
    _screen.activeform.release()
    RETURN
  ENDIF
   USE IN rwLabel
 ENDIF
USE && To Close temp tables cTemp
RETURN    
