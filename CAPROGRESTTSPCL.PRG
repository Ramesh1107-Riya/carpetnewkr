*Carpet Progress Report made from Order Not Distributed Report- for this required fileds are little more
SET DELETED ON
Set talk off
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

SET PROCEDURE TO CATOOL
DO csTrimInfo      && Trim Information for Check Purpose !
Open Database Carpet

SELECT BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR , SQMT, PO_DT,c.TSTATUS,SPCL_INST,WASHTYPE;
FROM  Cabuyord b, CSTATUS c;
WHERE c.status=b.cstatus .AND. PO_DT>=m.Startdt .and. PO_DT<=m.Enddt .and. b.CSTATUS<>'Exported';
INTO CURSOR BUYSTATUS

SELECT BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR , SUM(SQMT) AS SQMT, PO_DT,TSTATUS,SPCL_INST,WASHTYPE;
FROM  BUYSTATUS;
WHERE ccsMatch6a(BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR) .AND. ccsMatch4A(WASHTYPE);
ORDER BY Bcode,Quality,TSTATUS;
Group By Bcode,Quality,TSTATUS;
INTO CURSOR CAPROGRES

SELECT BCODE,QUALITY,SQMT,PO_DT,TSTATUS,SQMT*0 AS DSQMT,SQMT*0 AS LSQMT,SQMT*0 AS RSQMT,SQMT*0 AS NSQMT,SQMT*0 AS ESQMT,SPCL_INST;
FROM CAPROGRES;
ORDER BY BCODE,Quality;
INTO CURSOR CAPROGRESDITN1

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose. Cursor CAPROGRESDITN (R/W)
*
set safety off
SELECT CAPROGRESDITN1
= AFIELDS(csccTmpArr)
CREATE CURSOR CAPROGRESDITN FROM ARRAY csccTmpArr
SELECT CAPROGRESDITN1
GO TOP
SCAN WHILE (.NOT. EOF())
    SCATTER TO csccTmpRec
    INSERT INTO CAPROGRESDITN FROM ARRAY csccTmpRec
	SELECT CAPROGRESDITN1
ENDSCAN
RELEASE csccTmpArr, csccTmpRec
USE IN CAPROGRESDITN1

*LSQMT_>On-loom (ONLOOM), NSQMT->NotDistri+Distri (NEWORD), RSQMT->RECD exclude EXPORTED, ESQMT->Exported
***** distribute all data according to fields (TT carpet Tsering Report)
SELECT CAPROGRES
DO WHILE .NOT. EOF()
SELECT CAPROGRESDITN
Locate for Bcode=Caprogres->Bcode .and. Quality=Caprogres->Quality
do case
	case CAPROGRES->TSTATUS='DISTRI'
		repl CAPROGRESDITN->DSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='ONLOOM'
		repl CAPROGRESDITN->LSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='NEWORD'
		repl CAPROGRESDITN->NSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='RECD'
		repl CAPROGRESDITN->RSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='EXPORTED'
		repl CAPROGRESDITN->ESQMT with CAPROGRES->sqmt
  endcase
   SELECT CAPROGRES
 	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO
set safety on

SELECT BCODE,QUALITY,sum(DSQMT) As DSQMT,sum(LSQMT) As LSQMT,sum(NSQMT) As NSQMT,sum(RSQMT) As RSQMT, sum(ESQMT) As ESQMT,SPCL_INST;
From CAPROGRESDITN;
ORDER BY BCODE,Quality;
Group By BCODE,Quality;
Into  Cursor CaProgRep1

SELECT i.BCODE,j.NAME,QUALITY,DSQMT,LSQMT,NSQMT,RSQMT,ESQMT,SPCL_INST;
From CaProgRep1 i,Cabuyer j;
Where i.BCODE=j.Bcode;
Into  Cursor CaProgRep

Select CaProgRep
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V" .and. m.Option="A" 
		Report form caprogresttspcl.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P" .and. m.Option="B" 
		Report form caprogresttspcl.frx to printer prompt noconsole
	Case  m.PrnStat="V" .and. m.Option="C"  
		EXPORT TO &exclfile TYPE XL5 FIELDS BCODE,NAME,QUALITY,DSQMT,LSQMT,NSQMT,RSQMT,ESQMT,SPCL_INST
 	Messagebox("Search Non Distributed Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
Endcase
Endif
USE IN CAPROGRESDITN
UNLOCK ALL
Return
