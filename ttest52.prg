*1)Need to Consider Invoice No. Entry
*2)Check If Data Already Entered Into Packtran, Give Message
*A)Data Needed to be inserted in to Packtran.dbf
Local m.Packno,m.Invno
m.Packno='19023'
m.Invno='FD-1009/19'
SELECT b.BCODE,s.CARPETNO,b.PO_NO,b.PO_DT,b.CTRL_NO, b.OL_NO,b.YRNCALDT,b.DESIGN,QUALITY,COLOUR,b.SZCODE,b.BREADTH,b.LENGTH,b.SQMT,b.SPCL_INST,b.Packno,b.shbr,b.shln,b.blno,b.pkcomment,b.WASHTYPE,b.SKUNO,b.code,b.NOTES,s.Entryby;
FROM  Cabuyord b;
Inner Join Casupord s;
On b.ol_no=s.ol_no;
WHERE !empty(fdate) .and. Packno=m.Packno;
UNION ALL;
SELECT BCODE, CARPETNO, PO_NO, PO_DT, CTRL_NO, OL_NO,YRNCALDT, DESIGN,QUALITY,SUBSTR(COLOUR,1,10) AS COLOUR,SZCODE,BREADTH,LENGTH,SQMT,SPCL_INST,Packno,shbr,shln,blno,pkcomment,WASHTYPE,SKUNO,CODE,SUBSTR(NOTES,1,40) AS NOTES,Entryby;
FROM  Stkcarpet;
WHERE Packno=m.Packno;		
Into cursor buysupstk

Select BCODE,CARPETNO,PO_NO,CTRL_NO AS BUYERNO,OL_NO,DESIGN,QUALITY,COLOUR,SZCODE,BREADTH,LENGTH,SQMT AS SQMTORD,SPCL_INST, Packno ,;
shbr AS SHIPBRTH,shln AS SHIPLNGTH,Round(shbr*shln/10000,2) as Sqmt, blno AS BALENO,pkcomment AS REMARK,WASHTYPE,SKUNO,NOTES,PADR('',10) AS Invno,ENTRYBY; 
From buysupstk;
Order by blno;
Into Cursor InitPack

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose.

USE (DBF([InitPack])) ALIAS InitPackU AGAIN IN 0 SHARED
USE IN Select([InitPack])

Update InitPackU;   && Updating Invno
Set Invno= m.Invno;
Where Packno=m.Packno

*B) Check If Data Already Entered Into Packtran.dbf (Duplicate in Packing)
Select p.Ol_No,p.Carpetno,p.Design,p.Quality,p.Colour,b.shbr,b.shln,b.packno,p.Invno,p.baleno,b.Entryby;
From buysupstk b,Packtran p;
Where b.ol_no=p.ol_no;
Into Cursor buyPack

Select buypack
If RECNO()<RECCOUNT()
	Messagebox("Some Carpets Already in Packing Entry, Packing Updation [FAIL] Press [Esc] Key to Exit!!!")
	brow title 'Duplicate Carpets Not Allowed in Packing, Updation [FAIL] press [Esc] Key to Exit'
	USE in InitPackU
Else
	*Use Packtran && NOT required coz dbf is opened above in B)
	Select Packtran
	Append From DBF('InitPackU')
	brow FOR Invno=m.Invno
	Use in InitPackU
	Messagebox("Packing List Updated Successful")
Endif
Return
	

**Updating Packno From Cabuyord Into Packtran
*C)*Updating 2 Files 
Select Cabuyord && values come FROM this table 
Scan
Update Packtran;
Set Packno= Cabuyord.Packno;
Where Packtran.Ol_No=Cabuyord.Ol_No
Endscan
