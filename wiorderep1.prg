Procedure Querygen
*******Calculate total till date DYINGLOAD=QUANTITY
SELECT QUALITY,COLOUR,SUM(DYINGLOAD) QUANTITY;
FROM WIRECV SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY;
FROM WITRNORD SHARE;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ORDER

***CALCULATE MONTH TOTAL
**quantity used not dyeingload, later change variable dyeingload
SET ANSI ON
SELECT QUALITY,COLOUR,SUM(DYINGLOAD) QUANTITY;
FROM WIRECV SHARE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECVM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY;
FROM WITRNORD SHARE;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ORDERM


SELECT REPSTOCK
INDEX ON QUALITY+COLOUR TAG REPSTOCK
set order to repstock
SELECT RECV
INDEX ON QUALITY+COLOUR TAG RECV
set order to recv
SELECT ORDER
INDEX ON QUALITY+COLOUR TAG ORDER
set order to ORDER
SELECT RECVM
INDEX ON QUALITY+COLOUR TAG RECVM
set order to recvm
SELECT ORDERM
INDEX ON QUALITY+COLOUR TAG ORDERM
set order to ORDERM


SELECT REPSTOCK
  GO TOP
DO WHILE .NOT. EOF()
  	=SEEK (REPSTOCK.QUALITY + REPSTOCK.COLOUR,"RECV")
  	IF .T.
    	REPL REPSTOCK.RECQTY WITH RECV.QUANTITY
    ENDIF
    
    =SEEK (REPSTOCK.QUALITY + REPSTOCK.COLOUR,"ORDER")
  	IF .T.
    	REPL REPSTOCK.ORDQTY WITH ORDER.QUANTITY
    ENDIF  
    
   	=SEEK (REPSTOCK.QUALITY + REPSTOCK.COLOUR,"RECVM")
  	IF .T.
    	REPL REPSTOCK.RECQTYM WITH RECVM.QUANTITY
    ENDIF
    
    =SEEK (REPSTOCK.QUALITY + REPSTOCK.COLOUR,"ORDERM")
  	IF .T.
    	REPL REPSTOCK.ORDQTYM WITH ORDERM.QUANTITY
    ENDIF  
    
  SELECT REPSTOCK
 IF .NOT. EOF()
   SKIP
 ENDIF
ENDDO
SET ANSI OFF
RETURN
**END OF Querygen

****One Customer all Quality (Detail Rep,Summary), One Customer One Quality (Detail Rep)

Procedure Detailrep
Do Case   
  	
  Case !Empty(m.quality) .and. !Empty(m.colour)
	SELECT * ;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING QUALITY=m.quality .and. COLOUR=m.colour &CONDITION;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3	

  *EXCLUE BALANCE=0 OR DO NOT INCLUDE BALANCE=0 UPON CONDITION
  Case !Empty(m.quality) 
	SELECT * ;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING QUALITY=m.quality &CONDITION;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3

	**EXCLUDE BALNCE=0 IN REPORT
  Case Empty(m.quality)  
	SELECT * ;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	HAVING (ORDQTY+ORDQTYM)!=(OPORDQTY+RECQTY+RECQTYM);
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3
Endcase  
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wiorder.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wiorder.frx to printer prompt noconsole
Endcase
Endif
RETURN

*All customer & All Quality
Procedure StockSumary
Do case
  Case m.chk1=1 .and. empty(m.quality)
	SELECT QUALITY,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,;
		SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	GROUP BY QUALITY;
	ORDER BY QUALITY;
	INTO CURSOR REP4

  Case m.chk1=1 .and. !empty(m.quality)
	SELECT QUALITY,SUM(OPORDQTY) OPORDQTY,SUM(RECQTY) RECQTY,SUM(ORDQTY) ORDQTY,;
		SUM(RECQTYM) RECQTYM,SUM(ORDQTYM) ORDQTYM;
	FROM REPSTOCK;
	WHERE OPORDQTY>0 .OR. RECQTY>0 .OR. ORDQTY>0 .OR. RECQTYM>0 .OR. ORDQTYM>0;
	GROUP BY QUALITY;
	HAVING QUALITY=m.quality;
	ORDER BY QUALITY;
	INTO CURSOR REP4
Endcase
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wiordersm.frx PREVIEW WINDOW wReport  
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wiordersm.frx to printer prompt noconsole
Endcase
Endif
RETURN
