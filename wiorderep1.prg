*******Procedure to print Particular Customer form wicolour, For Particular Colour
**Repstock same in both
SET DELETED ON
SET TALK OFF
SET SAFE OFF

Procedure custcolor
CREATE CURSOR REPSTOCK (QUALITY C(8),COLOUR C(10),OPORDQTY N(10,3),;
RECQTY N(11,3),ORDQTY N(11,3),RECQTYM N(11,3),ORDQTYM N(11,3))

SELECT REPSTOCK
APPEND FIELDS QUALITY,COLOUR,OPORDQTY FROM WISTOCK FOR CUSTOMER=m.customer
RETURN

