CLOSE ALL
SET ANSI ON
SET SAFE OFF

SELECT INVNO;
FROM INVTRAN;
WHERE EMPTY(INVDT);
UNION ALL;
SELECT INVNO;
FROM PACKTRAN;
WHERE .NOT. EXISTS(SELECT INVNO FROM INVTRAN;
					WHERE PACKTRAN.INVNO=INVTRAN.INVNO;
					.AND. !EMPTY(INVTRAN.INVDT));
INTO CURSOR INVTEMP

SELECT DISTINCT INVNO;
FROM INVTEMP;
INTO CURSOR INVTEMP2

SELECT DISTINCT I.INVNO, P.BCODE, P.EXPDT;
FROM INVTEMP2 I, PACKTRAN P ;
WHERE I.INVNO=P.INVNO;
ORDER BY I.INVNO;
INTO CURSOR NOINVDT NOFILTER
					
					
SELECT NOINVDT
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V"
		Report form repnoinvdt.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form repnoinvdt.frx to printer prompt noconsole
Endcase
Endif
Return


