*Carpet Progress Report made from Order Not Distributed Report- for this required fileds are little more
SET DELETED ON
Set talk off
Set safe off
Set Date to Briti
Set Century on
SET ANSI ON

SET PROCEDURE TO CATOOL
DO csTrimInfo      && Trim Information for Check Purpose !
Open Database Carpet

SELECT BCODE, PO_NO, QUALITY, DESIGN, SZCODE, SUBSTR(COLOUR,1,10) AS COLOUR,SQMT,PO_DT,Packno,BLNO,CSTATUS,WASHTYPE;
FROM  Stkcarpet;
WHERE cstatus<>"Exported" .and. PO_DT>=m.Startdt .and. PO_DT<=m.Enddt;
UNION ALL;
SELECT  BCODE, PO_NO, QUALITY, DESIGN, SZCODE, SUBSTR(COLOUR,1,10) AS COLOUR,SQMT,PO_DT,Packno,BLNO,CSTATUS,WASHTYPE;
FROM  Cabuyord;
WHERE cstatus<>"Exported" .and. PO_DT>=m.Startdt .and. PO_DT<=m.Enddt;
Into cursor  BUYSTA1

SELECT BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR , SQMT, PO_DT,c.TSTATUS,Packno,BLNO,WASHTYPE;
FROM BUYSTA1 b, CSTATUS c;
WHERE c.status=b.cstatus;
INTO CURSOR BUYSTATUS1

SELECT BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR , SUM(SQMT) AS SQMT, PO_DT,TSTATUS,Packno,BLNO;
FROM  BUYSTATUS1;
WHERE ccsMatch6a(BCODE, PO_NO, QUALITY, DESIGN, SZCODE, COLOUR) .AND. ccsMatch4A(WASHTYPE);
ORDER BY Bcode,Quality,TSTATUS;
Group By Bcode,Quality,TSTATUS;
INTO CURSOR CAPROGRES

****************************************
SELECT Distinct BCODE,QUALITY,SQMT,PO_DT,TSTATUS,Sqmt*0 As NSQMT,Sqmt*0 As DSQMT,Sqmt*0 As LSQMT,Sqmt*0 As UWSQMT,Sqmt*0 As IWSQMT,Sqmt*0 As RWSQMT,Sqmt*0 As CISQMT;
FROM CAPROGRES;
ORDER BY BCODE,Quality;
INTO CURSOR CAPROGRESDITN1

* Since the CURSOR Generated by SELECT SQL is Read-Only, we need to make
* another Cursor for Read-Write purpose. Cursor CAPROGRESDITN (R/W)
*
set safety off
SELECT CAPROGRESDITN1
= AFIELDS(csccTmpArr)
CREATE CURSOR CAPROGRESDITN FROM ARRAY csccTmpArr
SELECT CAPROGRESDITN1
GO TOP
SCAN WHILE (.NOT. EOF())
    SCATTER TO csccTmpRec
    INSERT INTO CAPROGRESDITN FROM ARRAY csccTmpRec
	SELECT CAPROGRESDITN1
ENDSCAN
RELEASE csccTmpArr, csccTmpRec
USE IN CAPROGRESDITN1

*NotDistri NSQMT
*Distri DSQMT
*On-Loom LSQMT
*UnWashed  UWSQMT
*IssueWash  IWSQMT
*RcdWash  RWSQMT
*CutIssue CISQMT
*!EMPTY(BLNO) PKSQMT .and. NotExorted (Packed)
*Exported EXPORTED ESQMT
***** distribute all data according to fields (TT carpet Tsering Sir Report)
SELECT CAPROGRES
DO WHILE .NOT. EOF()
SELECT CAPROGRESDITN
Locate for Bcode=Caprogres->Bcode .and. Quality=Caprogres->Quality
do case
	case CAPROGRES->TSTATUS='NotDistri'
		repl CAPROGRESDITN->NSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='Distri'
		repl CAPROGRESDITN->DSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='On-Loom'
		repl CAPROGRESDITN->LSQMT with CAPROGRES->sqmt	
	case CAPROGRES->TSTATUS='UnWashed'
		repl CAPROGRESDITN->UWSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='IssueWash'
		repl CAPROGRESDITN->IWSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='RcdWash'
		repl CAPROGRESDITN->RWSQMT with CAPROGRES->sqmt
	case CAPROGRES->TSTATUS='CutIssue'
		repl CAPROGRESDITN->CISQMT with CAPROGRES->sqmt	
  endcase
   SELECT CAPROGRES
 	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

SELECT BCODE,QUALITY,sum(NSQMT) As NSQMT, sum(DSQMT) As DSQMT,sum(LSQMT) As LSQMT,sum(UWSQMT) As UWSQMT,sum(IWSQMT) As IWSQMT,sum(RWSQMT) As RWSQMT,;
 sum(CISQMT) As CISQMT;
From CAPROGRESDITN; 
ORDER BY BCODE,Quality;
Group By BCODE,Quality;
Into  Cursor CaProgRep1

SELECT i.BCODE,j.NAME,QUALITY, NSQMT, DSQMT, LSQMT, UWSQMT, IWSQMT, RWSQMT, CISQMT; 
From CaProgRep1 i,Cabuyer j; 
Where i.BCODE=j.Bcode;
Into  Cursor CaProgRep

Select CaProgRep
SET COLOR TO
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
Do Case
	Case m.PrnStat="V" .and. m.Option="A" 
		Report form caprogresttdtl.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P" .and. m.Option="B" 
		Report form caprogresttdtl.frx to printer prompt noconsole
	Case  m.PrnStat="V" .and. m.Option="C"  
		EXPORT TO &exclfile TYPE XL5 FIELDS BCODE,NAME,QUALITY,NSQMT,DSQMT,LSQMT,UWSQMT,IWSQMT,RWSQMT,CISQMT
 	Messagebox("Search Non Distributed Report Successfully Exported to Excel, Open Excel, Select Folder-> Carpetnew , Search for Excel File")
Endcase
Endif
USE IN CAPROGRESDITN
UNLOCK ALL
Return
