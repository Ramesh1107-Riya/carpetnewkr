*wissdata, Calculate Issue-Return Balance, Show Quality,Colour,Netweight for Matching Quality
Do Calculatebalance 
Do wrtn
Do wiss
Select sum(issqty-retnqty) AS balance;
From IssRetBal;
Into Cursor IssRet
Pisbalance=IssRet->balance

Procedure Calculatebalance
CREATE CURSOR IssRetBal (OL_NO C(15), QUALITY C(10),COLOUR C(10),RETNQTY N(11,3),ISSQTY N(11,3))
Return

Procedure wrtn
SELECT OL_NO,QUALITY,COLOUR,SUM(QUANTITY) RETNQTY;
FROM WIRETURN ;
WHERE OL_NO=PISOL_NO .AND. QUALITY=PISQUALITY .AND. COLOUR=PISCOLOUR;
GROUP BY OL_NO,QUALITY,COLOUR;
ORDER BY OL_NO,QUALITY,COLOUR;
INTO CURSOR RETN

SELECT IssRetBal
APPEND FIELDS OL_NO,QUALITY,COLOUR,RETNQTY FROM DBF ('RETN') 
RETURN

Procedure wiss
SELECT OL_NO,QUALITY,COLOUR,SUM(QUANTITY) ISSQTY;
FROM WIISSUE ;
WHERE OL_NO=PISOL_NO .AND. QUALITY=PISQUALITY .AND. COLOUR=PISCOLOUR;
GROUP BY OL_NO,QUALITY,COLOUR;
ORDER BY OL_NO,QUALITY,COLOUR;
INTO CURSOR ISSUE

SELECT IssRetBal
APPEND FIELDS OL_NO,QUALITY,COLOUR,ISSQTY FROM DBF ('ISSUE') 
RETURN

