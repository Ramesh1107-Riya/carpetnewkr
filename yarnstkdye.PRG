*******Procedure to print Particular Customer form wicolour, For Particular Colour
**Repstock same in both
SET DELETED ON
SET TALK OFF
SET SAFE OFF

CREATE CURSOR REPSTOCK(WASHTYPE C(10),QUALITY C(10),OPENBAL N(10,3),RECQTY N(11,3),RETNQTY N(11,3),ISSQTY N(11,3),RCOD C(3))

SELECT WASHTYPE,QUALITY,sum(OPENBAL) AS QUANTITY,PADR('WOP',3) as RCOD;
FROM WISTOCK;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR WIOP

SELECT WASHTYPE,QUALITY,SUM(QUANTITY) QUANTITY,PADR('REV',3) as RCOD;
FROM WIRECV;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR RECV

SELECT WASHTYPE,QUALITY,SUM(QUANTITY) QUANTITY,PADR('RTN',3) as RCOD;
FROM WIRETURN;
WHERE dyewht='D';
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR RETN

SELECT WASHTYPE,QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISS',3) as RCOD;
FROM WIISSUE;
WHERE dyewht='D';
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR ISSUE

*---all data in same container distinguished by rcode
SELECT WASHTYPE,QUALITY,QUANTITY,RCOD;
FROM WIOP;
UNION ALL;
SELECT WASHTYPE,QUALITY,QUANTITY,RCOD;
FROM RECV;
UNION ALL;
SELECT WASHTYPE,QUALITY,QUANTITY,RCOD;
FROM RETN;
UNION ALL;
SELECT WASHTYPE,QUALITY,QUANTITY,RCOD;
FROM ISSUE;
INTO CURSOR wstk

***** distribute all data according to fields
SELECT wstk 
DO WHILE .NOT. EOF()
SELECT REPSTOCK
APPEN BLANK
repl quality with wstk->quality,rcod with wstk->rcod,washtype with wstk->washtype

do case
	case rcod='WOP'
		repl repstock->OPENBAL with wstk->Quantity
	case rcod='REV'
		repl repstock->RECQTY with wstk->Quantity
	case rcod='RTN'
		repl repstock->RETNQTY with wstk->Quantity
	case rcod='ISS'
		repl repstock->ISSQTY with wstk->Quantity
  endcase
   SELECT wstk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
***REQUIRED FOR YARN CALCULATION
SELECT WASHTYPE,QUALITY,SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY,SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY;			 
FROM REPSTOCK;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCK1A

****REQUIRED FOR STOCK
SELECT WASHTYPE,QUALITY,SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY,SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY;			 
FROM REPSTOCK;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCK1


SELECT WASHTYPE,QUALITY,OPENBAL+RECQTY+RETNQTY-ISSQTY AS BALANCE;			 
FROM REPSTOCK1;
GROUP BY WASHTYPE,QUALITY;
ORDER BY WASHTYPE,QUALITY;
INTO CURSOR REPSTOCK1B

SELECT i.WASHTYPE,i.QUALITY,i.BALANCE,j.YTYPE;
FROM REPSTOCK1B i,Wiqlty j;
WHERE i.quality=j.quality;
INTO CURSOR REPSTOCKC

SELECT WASHTYPE,SUM(BALANCE) AS BALANCE,YTYPE;
FROM REPSTOCKC;
GROUP BY WASHTYPE,YTYPE;
INTO CURSOR REPSTOCKDYE

************Total PCI Dyed Silk/Yarn*******
SELECT Washtype,Ytype,Balance;
FROM REPSTOCKDYE;
Where Washtype="PCI" .and. Ytype="SILK";
Into Cursor REPPCIs

Public m.DSilkJ,m.DYarnJ

SELECT REPPCIs
m.DSilkJ=RepPcis->Balance
****************************************
SELECT Washtype,Ytype,Balance;
FROM REPSTOCKDYE;
Where Washtype="PCI" .and. Ytype="YARN";
Into Cursor REPPCIy

SELECT REPPCIy
m.DYarnJ=RepPciy->Balance
