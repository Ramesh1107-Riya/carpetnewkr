* BARCODE
SET TALK OFF
SET CENTURY ON
SET DATE TO BRITISH
SET SAFE OFF
SET ANSI ON

OPEN DATABASE CARPET
Select *;
From expackingnp;
where Alltrim(invno)=Alltrim(m.invno);
Into cursor packdtl

Dimension packdata (1,22)
Store ' ' to packdata
Select packdtl
copy to ARRAY packdata

*Making Packing List, Data Formatted for N.P. Rugs
*1) For Joining we are eliminating field for better performance
SELECT  p.carpetno,p.DESIGN, COLOUR, p.QUALITY;
FROM Packtran p,cadesign d;
Where p.Design=d.code .and. p.Quality=d.Quality;
HAving Invno = m.invno;
ORDER BY SLNO;
Into Cursor temp1

*2) Getting Design from DgnDesc for packing list
SELECT p.carpetno, d.Code,d.DgnDesc,d.Matcomp; 
FROM temp1 p, CaDesign d;
Where p.Design=d.code;
Into Cursor Dgn1 

*3) Getting Carpet Quality from Desc for packing list
SELECT p.carpetno, p.Quality,d.Desc; 
FROM temp1 p, Caqlty d;
Where p.Quality=d.code; 
Into cursor Qlty1

*4) Joining Tables 1&2, 1&2 with 3, 1&2&3 with 4
SELECT  t.carpetno,t.DESIGN,d.DgnDesc,d.Matcomp,t.COLOUR,t.QUALITY;
FROM temp1 t , Dgn1 d;
Where t.carpetno=d.carpetno;
Into Cursor jn1

SELECT  t.carpetno,t.DESIGN,t.DgnDesc,t.Matcomp,t.COLOUR,t.QUALITY,q.Desc as QltyDesc;
FROM jn1 t , Qlty1 q;
Where t.carpetno=q.carpetno;
Into Cursor jn3
**************************************
***Design has Quality,
SELECT p.BCODE,INVNO, BALENO,CARPETNO, SLNO, PO_NO, OL_NO, p.DESIGN, COLOUR, FIELDCODE , p.QUALITY,d.code as DgnName,d.desc DgnCode,d.Matcomp,p.Diamtr,p.Cubmtr,p.codesc,;
SHIPBRTH,SHIPLNGTH, iif(SL_NO='NORMAL',' ',SL_NO) As SpecialMark, SQMT, BALEWT,Remark,Comment,p.SizeCode1,Subbuyer,Buyerno,Alltrim(STR(SHIPBRTH))+' x '+Alltrim(STR(SHIPLNGTH)) As Size;
FROM Packtran p,CaDesign d;
Where p.Design=d.code .and. p.Quality=d.Quality;
Into Cursor pack1

SELECT BCODE,INVNO, BALENO,p.CARPETNO, SLNO, PO_NO, OL_NO, p.DESIGN, p.COLOUR, FIELDCODE ,p.QUALITY,DgnName,DgnCode,d.DgnDesc,p.CoDesc,d.QltyDesc,;
SHIPBRTH,SHIPLNGTH,SpecialMark,(shipbrth*shiplngth)/10000 as SQMT1, BALEWT,Remark,Comment,SizeCode1,Subbuyer,Buyerno,Size,p.Diamtr,d.Matcomp,p.Cubmtr;
FROM pack1 p, jn3 d;
Where p.carpetno=d.carpetno;
ORDER BY SLNO;
Into Cursor cPack

***Selecting Particular Record for Printing****
SELECT *, .f. as label; && a logical field Label is added to cursor cBardcode
FROM cPack ;
ORDER BY slno;
INTO CURSOR cBarcode

IF RECCOUNT("cBarcode") <= 0
  ?? CHR(7)
  WAIT WINDOW "No Matching Records found ..." TIMEOUT 1
  RETURN 0
ENDIF


* CURSOR Generated by SELECT SQL is Read-Only
* We need to make, another Cursor for Read-Write purpose.

SELECT *;
FROM cBarcode;
ORDER BY slno;
INTO CURSOR cTemp NOFILTER

USE (DBF([cTemp])) ALIAS rwBarcode AGAIN IN 0 SHARED
USE IN SELECT([cTemp])

*****************
PRIVATE  m.csVar1,m.csVar2,m.csVar9,mfdate
m.csVar3=.T.
m.csVar4=.F.

* Now Display ALL the Found Records and allow the user to Mark them for Printing

*SET COLOR TO
DEFINE WINDOW csoSrchWn_ FROM 02,00 TO 50,112 IN SCREEN DOUBLE NOCLOSE ;
  NOFLOAT NOGROW NOZOOM TITLE "Print Selected Lables, [Y] to Select - and Press [F10] To Print, [Esc] to Exit " COLOR SCHEME 10 && you can get better this color tested 11/5/10
?? CHR(7)

*DO MessDisplay WITH "Mark for Distribution with [Y] - and press [F10] when Done     [ESC]= Exit"
WAIT WINDOW ALLTRIM(STR(RECCOUNT("cBarcode"))) + " Matching Pieces Found !" NOWAIT
USE IN cBarcode

SELECT rwBarcode
REPLACE ALL LABEL      WITH .F.
GO TOP
INDEX ON Slno TAG Slnondx
SET ORDER TO Slnondx
m.csVar9  = ON("KEY", "F10")
ON KEY LABEL F10     KEYBOARD CHR(23)

BROWSE FIELDS LABEL:H="Print?":P="Y":8, Slno:H="SL No.":8:R,  Baleno:H="Bale No":8:R,Carpetno:H="Carpet No.":12:R,Design:H="DgnDesc":20:R,Colour:H="Colour":12:R,;
   Shipbrth:H="Breadth":8:R,Shiplngth:H="Length":7:R,Sqmt1:H="Sq.Mt.":7:R,Buyerno:H="Buyer No.":20:R REST FREEZE LABEL NOAPPEND NODELETE NOMENU;
  TITLE "Select Barcode to Print by pressing [Y] and Press [F10] For Print,  [Esc] to Exit" WINDOW ;
  csoSrchWn_  COLOR SCHEME 10 && test 11/5/10 this is best color in color scheme
 
m.csVar1  = LASTKEY()
ON KEY LABEL F10   &csVar9
***End of Selecting Particular Record

Select rwBarcode
SET FILTER TO LABEL
*********Printing
  SET COLOR TO
	If RECNO()>RECCOUNT()
		Messagebox("Record Not Found for the above seletion!!!")
	Else
		Do Case
			Case m.PrnStat="V"
				Label form label2.lbx to console preview in screen
			Case m.PrnStat="P"
				Label form label2.lbx to printer prompt noconsole
		Endcase
	Endif
*********end print
  
IF m.csVar1 = 23     && F10 Pressed: ask other Inputs to Record !
  COUNT TO m.csVar1  FOR LABEL
  IF m.csVar1 <= 0
    ?? CHR(7)
    WAIT WINDOW "No Pieces Marked for Distribution !!" TIMEOUT 2
    USE IN rwBarcode
    _screen.activeform.release()
    RETURN
  ENDIF
   USE IN rwBarcode
 ENDIF
USE && To Close temp tables cTemp
RETURN    


