SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITYI,PO_NO,PARTY;
FROM WIISSUE;
GROUP BY PO_NO,PARTY;
ORDER BY PO_NO,PARTY;
INTO CURSOR ISSUE

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITYR,PO_NO,PARTY;
FROM WIRETURN;
GROUP BY PO_NO,PARTY;
ORDER BY PO_NO,PARTY;
INTO CURSOR RETNM

SELECT i.PO_NO,i.PARTY,i.QUANTITYI,r.QUANTITYR,i.QUANTITYI-r.QUANTITYR as QUANTITY;
From Issue i;
Left Join Retnm r;
On i.po_no=r.po_no .and. i.party=r.party;
Order by i.party

