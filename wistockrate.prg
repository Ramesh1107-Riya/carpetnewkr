**Dyed Yarn Stock Report with Rate Amt SET DELETED ON
SET TALK OFF
SET SAFE OFF

Procedure Querygen
CREATE CURSOR REPSTOCK (QUALITY C(10),COLOUR C(10),OPENBAL N(10,3),;
						RECQTY N(11,3),RETNQTY N(11,3),ISSQTY N(11,3),RECQTYM N(11,3),RETNQTYM N(11,3),ISSQTYM N(11,3),RCOD C(3))
*******Calculate total till date
IF !EMPTY(m.colour) && Select for particular colour
	SELECT QUALITY,COLOUR,(OPENBAL) AS QUANTITY,PADR('WOP',3) as RCOD;
	FROM WISTOCK;
	WHERE Colour=alltrim(m.colour);
	INTO CURSOR WIOP
ELSE
	SELECT QUALITY,COLOUR,(OPENBAL) AS QUANTITY,PADR('WOP',3) as RCOD;
	FROM WISTOCK;
	INTO CURSOR WIOP
ENDIF

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REV',3) as RCOD;
FROM WIRECV;
WHERE date<msdate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('RTN',3) as RCOD;
FROM WIRETURN;
WHERE date<msdate .and. dyewht='D';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RETN

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISS',3) as RCOD;
FROM WIISSUE;
WHERE date<msdate .and. dyewht='D';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ISSUE

***CALCULATE MONTH TOTAL
SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REM',3) as RCOD;
FROM WIRECV;
WHERE date>=msdate .and. date<=medate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECVM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('RTM',3) as RCOD;
FROM WIRETURN;
WHERE date>=msdate .and. date<=medate .and. dyewht='D';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RETNM

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISM',3) as RCOD;
FROM WIISSUE;
WHERE date>=msdate .and. date<=medate .and. dyewht='D';
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR ISSUEM

*---all data in same container distinguished by rcode
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WIOP;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RECV;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RETN;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM ISSUE;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RECVM;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RETNM;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM ISSUEM;
INTO CURSOR wstk

***** distribute all data according to fields
SELECT wstk 
DO WHILE .NOT. EOF()
SELECT REPSTOCK
APPEN BLANK
repl quality with wstk->quality,colour with wstk->colour,rcod with wstk->rcod

do case
	case rcod='WOP'
		repl repstock->OPENBAL with wstk->Quantity
	case rcod='REV'
		repl repstock->RECQTY with wstk->Quantity
	case rcod='RTN'
		repl repstock->RETNQTY with wstk->Quantity
	case rcod='ISS'
		repl repstock->ISSQTY with wstk->Quantity
	case rcod='REM'
		repl repstock->RECQTYM with wstk->Quantity
	case rcod='RTM'
		repl repstock->RETNQTYM with wstk->Quantity
	case rcod='ISM'
		repl repstock->ISSQTYM with wstk->Quantity
  endcase
   SELECT wstk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

***smmation on quality
***REQUIRED FOR YARN CALCULATION
SELECT QUALITY,COLOUR, SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY, SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
						SUM(RECQTYM) RECQTYM, SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;			 
FROM REPSTOCK;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR REPSTOCK1A
****REQUIRED FOR STOCK
SELECT QUALITY, SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY, SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
						SUM(RECQTYM) RECQTYM, SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;			 
FROM REPSTOCK;
GROUP BY QUALITY;
ORDER BY QUALITY;
INTO CURSOR REPSTOCK1
RETURN
**END OF Querygen

****One Customer all Quality (Detail Rep,Summary), One Customer One Quality (Detail Rep), -ve,+ve all stock report
Procedure Detailrep
Do Case
  Case !Empty(m.quality) .and. !Empty(m.colour)
	SELECT QUALITY,COLOUR, SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY, SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
						SUM(RECQTYM) RECQTYM, SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;			 
	FROM REPSTOCK;
	HAVING QUALITY=m.quality .and. colour=m.colour;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A
	
	SELECT r.QUALITY,r.Colour,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	INTO CURSOR REP3		

  Case !Empty(m.quality) .and. Empty(m.colour)
	SELECT QUALITY,COLOUR, SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY, SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
						SUM(RECQTYM) RECQTYM, SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;			 
	FROM REPSTOCK;
	HAVING QUALITY=m.quality;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A
	
	SELECT r.QUALITY,r.Colour,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,w.YTYPE  ;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	INTO CURSOR REP3	

  Case Empty(m.quality)  .and. Empty(m.colour)
	SELECT QUALITY,COLOUR, SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY, SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
						SUM(RECQTYM) RECQTYM, SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;			 
	FROM REPSTOCK;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REP3A
	
	SELECT r.QUALITY,r.Colour,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,w.YTYPE;
	FROM REP3A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	INTO CURSOR REP3	
Endcase  
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form wirepstockra.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wirepstockra.frx to printer prompt noconsole
Endcase
Endif
RETURN

*All customer & All Quality
Procedure StockSumary
SET COLOR TO
Do case
  Case m.chk1=1 .and. empty(m.quality) .and. empty(colour)
	SELECT QUALITY,SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY,SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
		SUM(RECQTYM) RECQTYM,SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;
	FROM REPSTOCK;
	GROUP BY QUALITY;
	ORDER BY QUALITY;
	INTO CURSOR REP4A
	
	SELECT r.QUALITY,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,W.YTYPE;
	FROM REP4A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE,r.QUALITY;
	INTO CURSOR REP4

  Case m.chk1=1 .and. !empty(m.quality) .and. empty(colour)
	SELECT QUALITY,SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY,SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
	SUM(RECQTYM) RECQTYM,SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;
	FROM REPSTOCK;
	WHERE OPENBAL>0 .OR. RECQTY>0 .OR. ISSQTY>0 .OR. RECQTYM>0 .OR. ISSQTYM>0;
	GROUP BY QUALITY;
	HAVING QUALITY=m.quality;
	ORDER BY QUALITY;
	INTO CURSOR REP4A
	
	SELECT r.QUALITY,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,W.YTYPE;
	FROM REP4A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE,r.QUALITY;
	INTO CURSOR REP4

  Case m.chk1=1 .and. !empty(m.quality) .and. !empty(m.colour)
	SELECT QUALITY,SUM(OPENBAL) OPENBAL,SUM(RECQTY) RECQTY,SUM(RETNQTY) RETNQTY,SUM(ISSQTY) ISSQTY,;
		SUM(RECQTYM) RECQTYM,SUM(RETNQTYM) RETNQTYM,SUM(ISSQTYM) ISSQTYM;
	FROM REPSTOCK;
	WHERE OPENBAL>0 .OR. RECQTY>0 .OR. ISSQTY>0 .OR. RECQTYM>0 .OR. ISSQTYM>0;
	GROUP BY QUALITY;
	HAVING QUALITY=m.quality .and. m.colour;
	ORDER BY QUALITY;
	INTO CURSOR REP4A
	
	SELECT r.QUALITY,(r.OPENBAL+r.RECQTY-r.ISSQTY+r.RECQTYM-r.ISSQTYM+r.RETNQTY+r.RETNQTYM) AS BALANCE,w.WSHRATE AS RATE,w.DESC,w.Ytype;
	FROM REP4A r;
	LEFT JOIN WIQLTY w;
	ON r.QUALITY=w.QUALITY;
	ORDER BY w.YTYPE,r.QUALITY;
	INTO CURSOR REP4	
Endcase
Select REP4
If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		*Report form wistocksum.frx to console preview in screen
		Report form wistocksumra.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form wistocksumra.frx to printer prompt noconsole
Endcase
Endif
RETURN


