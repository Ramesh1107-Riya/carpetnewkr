SELECT BCODE, CARPETNO, PO_NO, PO_DT, CTRL_NO, OL_NO, DESIGN,QUALITY,SUBSTR(COLOUR,1,10) AS COLOUR,SZCODE,BREADTH,LENGTH,SQMT, SPCL_INST, CSTATUS,SUBSTR(NOTES,1,30) AS NOTES,SKUNO,ORDER_TYPE, FIELDCODE, WASHTYPE,CTYPE,COMMENT,qty;
FROM  Stkcarpet;
WHERE cstatus<>"Exported";
UNION ALL;
SELECT b.BCODE,s.CARPETNO,b.PO_NO,b.PO_DT,b.CTRL_NO, b.OL_NO,b.DESIGN,QUALITY,COLOUR,b.SZCODE,b.BREADTH,b.LENGTH,b.SQMT,b.SPCL_INST,b.CSTATUS,b.NOTES,b.SKUNO,b.ORDER_TYPE,b.FIELDCODE,b.WASHTYPE,b.CTYPE,b.COMMENT,qty;
FROM  Cabuyord b;
Inner Join Casupord s;
On b.ol_no=s.ol_no;
WHERE b.cstatus<>"Exported" .and. !empty(fdate);
Into Cursor temp1
*****************************************************

SELECT BCODE,CARPETNO,PO_NO,PO_DT,CTRL_NO,OL_NO,DESIGN,QUALITY,COLOUR,SZCODE,BREADTH,LENGTH,sum(SQMT) as SQMT,sum(qty) as qty,SPCL_INST,CSTATUS,NOTES,SKUNO,ORDER_TYPE,FIELDCODE,WASHTYPE,CTYPE,COMMENT;
FROM  temp1;
Group by Design,Quality,colour,szcode,sqmt
