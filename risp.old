********************************************************************************
procedure __RI_UPDATE_wiqlty
** "Referential integrity update trigger for" wiqlty
LOCAL llRetVal
llRetVal = .t.
PRIVATE pcParentDBF,pnParentRec,pcChildDBF,pnChildRec,pcParentID,pcChildID
PRIVATE pcParentExpr,pcChildExpr
STORE "" TO pcParentDBF,pcChildDBF,pcParentID,pcChildID,pcParentExpr,pcChildExpr
STORE 0 TO pnParentRec,pnChildRec
IF _triggerlevel=1
  BEGIN TRANSACTION
  PRIVATE pcRIcursors,pcRIwkareas,pcRIolderror,pnerror,;
  pcOldDele,pcOldExact,pcOldTalk,pcOldCompat,PcOldDBC
  pcOldTalk=SET("TALK")
  SET TALK OFF
  pcOldDele=SET("DELETED")
  pcOldExact=SET("EXACT")
  pcOldCompat=SET("COMPATIBLE")
  SET COMPATIBLE OFF
  SET DELETED ON
  SET EXACT OFF
  pcRIcursors=""
  pcRIwkareas=""
  pcRIolderror=ON("error")
  pnerror=0
  ON ERROR pnerror=rierror(ERROR(),message(),message(1),program())
  IF TYPE('gaErrors(1)')<>"U"
    release gaErrors
  ENDIF
  PUBLIC gaErrors(1,12)
  pcOldDBC=DBC()
  SET DATA TO ("CARPET")
ENDIF first trigger
LOCAL lcParentID && parent's value to be sought in child
LOCAL lcOldParentID && previous parent id value
LOCAL lcChildWkArea && child work area handle returned by riopen
LOCAL lcChildID && child's value to be sought in parent
LOCAL lcOldChildID && old child id value
LOCAL lcParentWkArea && parentwork area handle returned by riopen
LOCAL lcStartArea
lcStartArea=select()
llRetVal=.t.
lcParentWkArea=select()
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("woolissu")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR QUALITY=lcOldParentID
    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the woolissu records
  =rireuse("woolissu",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("yrecp")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR QUALITY=lcOldParentID
    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the yrecp records
  =rireuse("yrecp",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("witrnord")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR QUALITY=lcOldParentID
    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the witrnord records
  =rireuse("witrnord",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
