procedure __RI_UPDATE_cabuyer
** "Referential integrity update trigger for" cabuyer
LOCAL llRetVal
llRetVal = .t.
PRIVATE pcParentDBF,pnParentRec,pcChildDBF,pnChildRec,pcParentID,pcChildID
PRIVATE pcParentExpr,pcChildExpr
STORE "" TO pcParentDBF,pcChildDBF,pcParentID,pcChildID,pcParentExpr,pcChildExpr
STORE 0 TO pnParentRec,pnChildRec
IF _triggerlevel=1
  BEGIN TRANSACTION
  PRIVATE pcRIcursors,pcRIwkareas,pcRIolderror,pnerror,;
  pcOldDele,pcOldExact,pcOldTalk,pcOldCompat,PcOldDBC
  pcOldTalk=SET("TALK")
  SET TALK OFF
  pcOldDele=SET("DELETED")
  pcOldExact=SET("EXACT")
  pcOldCompat=SET("COMPATIBLE")
  SET COMPATIBLE OFF
  SET DELETED ON
  SET EXACT OFF
  pcRIcursors=""
  pcRIwkareas=""
  pcRIolderror=ON("error")
  pnerror=0
  ON ERROR pnerror=rierror(ERROR(),message(),message(1),program())
  IF TYPE('gaErrors(1)')<>"U"
    release gaErrors
  ENDIF
  PUBLIC gaErrors(1,12)
  pcOldDBC=DBC()
  SET DATA TO ("CARPET")
ENDIF first trigger
LOCAL lcParentID && parent's value to be sought in child
LOCAL lcOldParentID && previous parent id value
LOCAL lcChildWkArea && child work area handle returned by riopen
LOCAL lcChildID && child's value to be sought in parent
LOCAL lcOldChildID && old child id value
LOCAL lcParentWkArea && parentwork area handle returned by riopen
LOCAL lcStartArea
lcStartArea=select()
llRetVal=.t.
lcParentWkArea=select()
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("capo")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the capo records
  =rireuse("capo",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("cadesign")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the cadesign records
  =rireuse("cadesign",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("stkcarpet")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the stkcarpet records
  =rireuse("stkcarpet",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("cabuyord")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the cabuyord records
  =rireuse("cabuyord",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("grmaster")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the grmaster records
  =rireuse("grmaster",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("grregstr")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR BCODE=lcOldParentID
    pnChildRec=recno()
    pcChildID=BCODE
    pcChildExpr="BCODE"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("BCODE",lcParentID,"CABUYER")
  ENDSCAN get all of the grregstr records
  =rireuse("grregstr",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("BCODE")
pcParentID=lcOldParentID
pcParentExpr="BCODE"
lcParentID=BCODE
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("wistock")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR CUSTOMER=lcOldParentID
    pnChildRec=recno()
    pcChildID=CUSTOMER
    pcChildExpr="CUSTOMER"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("CUSTOMER",lcParentID,"CABUYER")
  ENDSCAN get all of the wistock records
  =rireuse("wistock",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
IF _triggerlevel=1
  do riend with llRetVal
ENDIF at the end of the highest trigger level
SELECT (lcStartArea)
RETURN llRetVal
** "End of Referential integrity Update trigger for" cabuyer
