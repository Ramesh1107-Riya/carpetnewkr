    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the wiissue records
  =rireuse("wiissue",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("yrnop")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR QUALITY=lcOldParentID
    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the yrnop records
  =rireuse("yrnop",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("yrnorder")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
  ENDIF not able to open the child work area
  pcChildDBF=dbf(lcChildWkArea)
  SELECT (lcChildWkArea)
  SCAN FOR QUALITY=lcOldParentID
    pnChildRec=recno()
    pcChildID=QUALITY
    pcChildExpr="QUALITY"
    IF NOT llRetVal
      EXIT
    ENDIF && not llretval
    llRetVal=riupdate("QUALITY",lcParentID,"WIQLTY")
  ENDSCAN get all of the yrnorder records
  =rireuse("yrnorder",lcChildWkArea)
  IF NOT llRetVal
    IF _triggerlevel=1
      DO riend WITH llRetVal
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN llRetVal
  ENDIF
ENDIF this parent id changed
SELECT (lcParentWkArea)
pcParentDBF=dbf()
pnParentRec=recno()
lcOldParentID=OLDVAL("QUALITY")
pcParentID=lcOldParentID
pcParentExpr="QUALITY"
lcParentID=QUALITY
IF lcParentID<>lcOldParentID
  lcChildWkArea=riopen("yrnrecvd")
  IF lcChildWkArea<=0
    IF _triggerlevel=1
      DO riend WITH .F.
    ENDIF at the end of the highest trigger level
    SELECT (lcStartArea)
    RETURN .F.
