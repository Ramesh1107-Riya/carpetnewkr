*  							REORDER.PRG
***WISTOCK CONTAINS OPENING,REORDER,QUALITY DESC ETC.
PROCEDURE STOCKBAL
Set talk off
Set safe off
CREATE CURSOR REPSTOCK (QUALITY C(10),COLOUR C(10),CUSTOMER C(10), OPENBAL N(10,3),;
				REORDERLVL N(10,3),	RECQTY N(11,3),ISSQTY N(11,3),RETQTY N(11,3),RCOD C(3))
*******Calculate total till date
IF !EMPTY(m.customer) && Select for particular customer
	SELECT QUALITY,COLOUR,(REORDERLVL) AS QUANTITY,PADR('REO',3) as RCOD;
	FROM WISTOCK;
	WHERE CUSTOMER=m.customer;
	INTO CURSOR REOD
ELSE
	SELECT QUALITY,COLOUR,(REORDERLVL) AS QUANTITY,PADR('REO',3) as RCOD;
	FROM WISTOCK;
	INTO CURSOR REOD
ENDIF

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('REV',3) as RCOD;
FROM WIRECV;
WHERE date<=m.TillDate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR RECV

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('ISS',3) as RCOD;
FROM WIISSUE;
WHERE date<=m.TillDate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WISS

SELECT QUALITY,COLOUR,SUM(QUANTITY) QUANTITY,PADR('RTN',3) as RCOD;
FROM WIRETURN;
WHERE date<=m.TillDate;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR WRTN

*---all data in same container distinguished by rcode
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM RECV;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WISS;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM WRTN;
UNION ALL;
SELECT QUALITY,QUANTITY,COLOUR,RCOD;
FROM REOD;
INTO CURSOR ordstk

***** distribute all data according to fields
SELECT ordstk 
DO WHILE .NOT. EOF()
SELECT REPSTOCK
APPEN BLANK
repl quality with ordstk->quality,colour with ordstk->colour,rcod with ordstk->rcod
do case
	case rcod='WOP'
		repl repstock->OPENBAL with ordstk->Quantity
	case rcod="REO"
		repl repstock->reorderlvl with ordstk->Quantity
	case rcod='REV'
		repl repstock->RECQTY with ordstk->Quantity
	case rcod='ISS'
		repl repstock->ISSQTY with ordstk->Quantity
	case rcod='RTN'
		repl repstock->RETQTY with ordstk->Quantity
  endcase
   SELECT ordstk
	IF .NOT. EOF()
	   SKIP
	ENDIF
ENDDO

PROCEDURE REORDERREP
SELECT QUALITY,COLOUR,OPENBAL,REORDERLVL,SUM(RECQTY) RECQTY,SUM(RETQTY) RETQTY, SUM(ISSQTY) ISSQTY; 
FROM  REPSTOCK;
GROUP BY QUALITY,COLOUR;
ORDER BY QUALITY,COLOUR;
INTO CURSOR REPSTOCK1

SELECT r.QUALITY,r.COLOUR,w.OPENBAL,w.CUSTOMER,r.REORDERLVL,r.RECQTY,r.RETQTY,r.ISSQTY;
FROM repstock1 r,wistock w;
WHERE r.quality=w.quality .AND. r.colour=w.colour;
ORDER BY r.quality,r.colour;
INTO CURSOR repstock2

IF !empty(quality)
	SELECT QUALITY,COLOUR,REORDERLVL,OPENBAL,CUSTOMER,RECQTY,RETQTY,ISSQTY,(OPENBAL+RECQTY+RETQTY-ISSQTY) AS CURBAL; 
	FROM  REPSTOCK2;
	WHERE REORDERLVL>(OPENBAL+RECQTY+RETQTY-ISSQTY).AND. QUALITY=m.Quality;
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REORDATA
ELSE
	SELECT QUALITY,COLOUR,REORDERLVL,OPENBAL,CUSTOMER,RECQTY,RETQTY,ISSQTY,(OPENBAL+RECQTY+RETQTY-ISSQTY) AS CURBAL; 
	FROM  REPSTOCK2;
	WHERE REORDERLVL>(OPENBAL+RECQTY+RETQTY-ISSQTY);
	GROUP BY QUALITY,COLOUR;
	ORDER BY QUALITY,COLOUR;
	INTO CURSOR REORDATA
ENDIF

If RECNO()>RECCOUNT()
	Messagebox("Record Not Found for the above seletion!!!")
Else
SET COLOR TO
Do Case
	Case m.PrnStat="V"
		Report form WiReorder.frx PREVIEW WINDOW wReport 
		DEACTIVATE WINDOW wReport
	Case m.PrnStat="P"
		Report form WiReorder.frx to printer prompt noconsole
Endcase
Endif
RETURN
